# tenant-portal example env file
# Copy this to .env and fill values before running migrations or starting the app.
# Do NOT commit your real .env to source control.

# Database connection string used by Prisma.
# For PostgreSQL:
# Example: postgresql://user:password@localhost:5432/dbname?schema=public
# If you are using Neon, your DATABASE_URL should be the Neon Postgres URL.
# DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"
#
# For local SQLite fallback:
# DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://user:password@localhost:5432/tenant_portal?schema=public"

# JWT secret used for generating session tokens
JWT_SECRET="change-me-to-a-long-random-secret"

# Pepper for deterministic HMAC hashing of API keys (must be stable)
API_KEY_PEPPER="change-me-and-keep-secret"

# Optional: Node environment
NODE_ENV=development
