{
  "name": "tenant-portal",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:generate:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "prisma:migrate:dev:sqlite": "prisma migrate dev --schema=prisma/schema.sqlite.prisma --name init",
    "example:partner-client": "node --enable-source-maps examples/partner-client.js",
    "example:seed-and-call": "node --enable-source-maps examples/seed-and-call.js",
    "example:integration-test": "node --enable-source-maps examples/integration-test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "next": "14.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4"
  }
}
