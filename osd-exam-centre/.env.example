# This app's own public URL, used to build the links inside emails
# (booking confirmation, seat-confirmed, nurture drip). Set to the real
# deployed domain before going live.
SITE_URL="http://localhost:3100"

# --- Database ---------------------------------------------------------------
# A dedicated Neon (or any Postgres) database/branch for THIS app. Do not
# point this at the EasyWay LMS's database — see README.md for why they stay
# separate.
#   DATABASE_URL         the POOLED string (via PgBouncer). What the app
#                         queries with — every serverless invocation is a
#                         fresh connection, so pooling matters here.
#   DIRECT_DATABASE_URL   the DIRECT string. What `prisma migrate` uses —
#                         PgBouncer's transaction mode doesn't support the
#                         prepared statements migrations need.
# Neon gives you both on the same project's connection-details page (the
# pooled one has "-pooler" in the hostname).
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# --- Admin back office --------------------------------------------------
# One shared password for the whole office (see lib/admin-auth.ts). Pick a
# real one before deploying — this is not a placeholder to skip.
ADMIN_PASSWORD=""
# Optional: a separate secret for signing the admin session cookie. Falls
# back to ADMIN_PASSWORD if unset.
ADMIN_SESSION_SECRET=""

# --- Manual bank-transfer payment (see lib/payments.ts) -------------------
# One school-wide Moniepoint account shown to every candidate; an admin
# verifies each transfer by hand. Not a live Monnify API integration.
# Defaults are the account on the school's own invoice template
# (Easyway Sprachschule / 6547656725 / Moniepoint MFB) — set these only to override.
EXAM_BANK_NAME="Moniepoint MFB"
EXAM_BANK_ACCOUNT_NAME="Easyway Sprachschule"
EXAM_BANK_ACCOUNT_NUMBER="6547656725"

# --- Letterhead on invoices and emails (see lib/config.ts OFFICE) ----------
# Defaults come from the school's invoice template; override if they change.
# OFFICE_EMAIL is also the Reply-To on every candidate email, so replies reach
# the exams desk even while SMTP_FROM rides on a different verified domain.
OFFICE_EMAIL="exams@easywaylanguageschool.com"
OFFICE_PHONE="+234 708 900 2534"
OFFICE_ADDRESS="23, Unity Road, Ikeja, Lagos"
OFFICE_WEBSITE="www.easywaylanguageschool.com"

# --- File storage (see lib/storage.ts) --------------------------------------
# Leave all four blank for local disk storage under public/uploads/ (dev
# only — Vercel's deployed filesystem is read-only, so uploads silently stop
# persisting there without these set). Works with Cloudflare R2, AWS S3, or
# any S3-compatible bucket.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Leave this blank — the default. Uploaded files (passport photos, bank
# slips) are then served through this app's own admin-gated proxy
# (/api/files/<key>, see app/api/files/[...key]/route.ts) rather than a
# public bucket URL — these are sensitive documents, and a bucket doesn't
# need to be public just because the app needs to read from it. Only set
# this (an R2 custom domain, a CDN) if the bucket is deliberately public.
S3_PUBLIC_BASE_URL=""

# --- Email (see lib/email.ts) ------------------------------------------------
# Without SMTP_HOST, emails are logged to the console instead of sent —
# fine for local dev, not for production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Easyway ÖSD Exam Centre <no-reply@easywayschoollms.com.ng>"

# --- "Need help?" support messages (see lib/support.ts) --------------------
# Where a candidate's help request gets emailed. Every message is also saved
# to the database (/admin/support) even without this set, but nobody in the
# office is notified until it is.
OFFICE_NOTIFICATION_EMAIL=""

# --- Candidate-journey cron (see app/api/cron/nurture/route.ts) -------------
CRON_SECRET=""
# The public landing page's prep-class banner (anonymous visitors). Journey emails
# link to this app's own /prepare page instead — a Panthexa candidate has no LMS account.
EXAM_PREP_CLASS_URL="https://easywayschoollms.com.ng/exams/osd"

# --- International card payments, via Flutterwave (see lib/payments.ts) ---
# For candidates paying from outside Nigeria who can't make a bank transfer.
# Bank transfer stays the default for everyone else — Flutterwave's ~3.9% on
# international cards is real money on a real fee. Setting the secret key is
# what turns the "Pay by international card" button on for candidates
# (cardPaymentsEnabled()); the webhook hash is optional but recommended —
# without it, only the browser-redirect settlement path runs (still
# reliable for a candidate who stays on the page through checkout).
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""
