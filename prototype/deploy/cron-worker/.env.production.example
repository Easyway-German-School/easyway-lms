# ---------------------------------------------------------------------------
# Self-hosted cron worker — environment template
#
# Copy to .env.production on the worker box and fill every value from the
# Vercel dashboard (Settings -> Environment Variables) directly, NOT
# `vercel env pull` — vars marked Sensitive (DATABASE_URL included) come back
# as "[SENSITIVE]" over the CLI on this project. The real DATABASE_URL /
# DIRECT_DATABASE_URL pair is also saved at
# ~/.secrets/easyway-db-connection.txt on the main dev machine.
#
# This is a NARROWER list than the app's own .env.example: only the jobs in
# src/lib/cron-jobs.ts run on this box, so there's no NEXTAUTH_*, no
# STRIPE/PAYSTACK, no signup-token gate, nothing browser-facing. If a job
# errors with a missing-env message that isn't listed here, add it —
# cron-jobs.ts is the source of truth for what this box actually touches.
# ---------------------------------------------------------------------------

# --- Database (same pooled/direct split as the app; see ../.env.example) ---
DATABASE_URL="postgresql://user:password@139.162.159.191/dbname?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@139.162.159.191/dbname?sslmode=require"

# --- Email (fee reminders, digests, nudges all go through this) -----------
EMAIL_PROVIDER="zoho"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Easyway LMS <no-reply@easyway.test>"
MAILERSEND_API_KEY=""
MAIL_DOMAIN="easywaylanguageschool.com"
MAIL_SCHOOL_NAME="Easyway Language School"
MAIL_SUPPORT_ADDRESS="support@easywaylanguageschool.com"
MAIL_NOREPLY_ADDRESS="donotreply@easywaylanguageschool.com"

# --- SMS queue --------------------------------------------------------------
# Whatever provider drain-sms-queue.ts reads today — leave unset to no-op.

# --- Push (daily-missions-push, streak-reminders) --------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- File storage (recording-reconcile, short-recording-purge, retention) --
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY=""
STORAGE_S3_SECRET=""
RECORDING_S3_BUCKET=""
RECORDING_S3_REGION="auto"
RECORDING_S3_ENDPOINT=""
RECORDING_S3_ACCESS_KEY=""
RECORDING_S3_SECRET=""
RECORDING_PUBLIC_BASE_URL=""

# --- AI (material-ai, class-transcription) ----------------------------------
# Same provider order as the app: Ollama -> Claude -> Groq -> DeepSeek -> mock.
# This box has no local Ollama, so set at least one hosted key or these two
# jobs just log { skipped: true } every tick instead of failing the run.
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""

# --- Retention ----------------------------------------------------------------
# "true" lets short-recording-purge actually delete. Look at a dry-run
# (RETENTION_AUTO unset) report before turning this on on a NEW box — it
# should already match what Vercel's cron was doing, not start fresh.
RETENTION_AUTO=""

# --- EduPrime platform webhook (low-balance-warnings touches billing) -------
PLATFORM_ENQUIRY_WEBHOOK=""

# CRON_SECRET is intentionally NOT here — this process calls the job
# functions directly, no HTTP, no bearer header. See README.md.
