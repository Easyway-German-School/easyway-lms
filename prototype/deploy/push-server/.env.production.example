# ---------------------------------------------------------------------------
# push-server — environment template
#
# Copy to .env.production on the push-server box and fill every value from
# the Vercel dashboard (Settings -> Environment Variables) directly, NOT
# `vercel env pull` — vars marked Sensitive come back as "[SENSITIVE]" over
# the CLI on this project. The real DATABASE_URL / DIRECT_DATABASE_URL pair
# is also saved at ~/.secrets/easyway-db-connection.txt on the main dev
# machine.
#
# NARROW on purpose: push-server/server.ts only reads the DB and verifies
# push tokens. No SMTP, no payment keys, no AI keys, nothing the cron worker
# needs — see deploy/cron-worker/.env.production.example for that box.
# ---------------------------------------------------------------------------

# --- Database (same pooled/direct split as the app) -------------------------
DATABASE_URL="postgresql://user:password@139.162.159.191/dbname?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@139.162.159.191/dbname?sslmode=require"

# --- Auth ---------------------------------------------------------------
# MUST be the EXACT same value as the main app's NEXTAUTH_SECRET in Vercel —
# this is what verifies the push-token a browser presents on connect (see
# src/lib/push-auth.ts). A mismatch here means every connection gets
# "invalid signature" and the client silently falls back to its HTTP poll —
# not a crash, so check this first if nothing seems to be happening.
NEXTAUTH_SECRET=""

# --- Optional tuning (both have sane defaults — see server.ts) -------------
PUSH_SERVER_PORT="8081"
PUSH_POLL_INTERVAL_MS="10000"
