/// School-wide configuration the office edits instead of asking for a deploy.
///
/// A key/value table rather than a column per setting, on purpose: the whole
/// point of the screen it backs is that the school can change how it runs
/// without a schema change, and a table that needs a migration per toggle
/// would defeat that within a week.
///
/// `tenantId` is NOT NULL here, unlike most tables that carry it. Two reasons.
/// A settings row with no owner is meaningless — there is no such thing as a
/// sitting timetable that belongs to no school. And a compound unique over a
/// NULLABLE column does not constrain the rows where it is null, because
/// Postgres treats every NULL as distinct: one school would quietly accumulate
/// a new row per save and read back whichever the planner happened to find.
model SchoolSetting {
  id String @id @default(cuid())

  /// Dotted name of the setting, e.g. "class.sessions".
  key String

  /// The setting itself. JSON so a shape can grow without a migration.
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId  String
  tenantRef Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// A partner's credential for the public API.
///
/// New table, so it ships ahead of the tenant migration without touching any
/// existing read. See src/lib/api/keys.ts for the format and why it has both a
/// prefix and a hash.
model ApiKey {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// What the partner calls it. Shown in their dashboard, never used for auth.
  name String

  /// The non-secret half — `ewk_live_a1b2c3d4`. Unique, indexed, and safe to
  /// log. Without it, "which key made this call?" can only be answered by
  /// storing the secret, and a support conversation about a misbehaving
  /// integration turns into a request to paste a live credential into a chat.
  prefix String @unique

  /// sha256 of the whole key. The secret half exists once, in the response
  /// that created it.
  keyHash String @unique

  /// live | test. A test key reaches the same endpoints and never touches
  /// real money or real students — no engineering team will integrate without
  /// somewhere safe to make mistakes.
  environment String @default("test")

  /// Comma-separated grants, e.g. "students:read,payments:read".
  scopes String @default("")

  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, revokedAt])
}

/// The answer we already gave to a request the partner is repeating.
///
/// Networks time out after the work is done. Without this, a partner's retry
/// enrols the student twice and charges them twice, and they cannot tell
/// whether the first call worked — which makes retrying unsafe, which makes
/// the API unusable for anything that matters.
model IdempotencyRecord {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The partner's own key, unique per tenant rather than globally: two
  /// partners must be able to pick the same string without colliding.
  key String

  /// sha256 of method + path + body. Reusing one key for a DIFFERENT request
  /// is a bug in the caller, and answering it with the old response would
  /// silently drop the new one — so it is refused instead.
  requestHash String

  statusCode   Int
  responseBody String

  createdAt DateTime @default(now())

  @@unique([tenantId, key])
  @@index([createdAt])
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  tutorId String?
  tutor   Lecturer? @relation(fields: [tutorId], references: [id], onDelete: SetNull)

  /**
   * Assignments set for this student by name, rather than to their level.
   */
  assignmentTargets AssignmentTarget[]

  // Official school identifier, e.g. EW/2026/A1/JUL/0007. Nullable because
  // students created before the scheme existed are backfilled by
  // scripts/backfill-student-codes.mjs rather than blocked at read time.
  studentCode String? @unique

  status        String @default("active")
  level         String @default("A1") // A1, A2, B1, B2, C1, C2
  /**
   * morning | afternoon | evening — which sitting of their level they attend.
   */
  sessionSlot   String @default("morning")
  /**
   * group | private. A private student sits no group timetable, so the
   * generated branch+level schedule does not apply to them — their calendar
   * comes from PrivateClass rows instead.
   */
  classType     String @default("group")
  /**
   * physical | hybrid | online — how this student attends.
   * physical  campus only. No live-class tab: there is no video lesson to
   * join, and showing them one they can never use is the fastest
   * way to make the portal look broken.
   * hybrid    registered at a campus but may join that same branch's class
   * over video. Gets both the campus features and the live room.
   * online    the Online branch. Video only, no campus.
   * Defaulted to physical so every student who registered before this existed
   * keeps the portal they already had.
   */
  deliveryMode  String @default("physical")
  pathway       String @default("Language training")
  examReadiness Int    @default(0)
  outcome       String @default("C1 readiness + German work placement support")
  nextLive      String @default("No live session scheduled")
  // Arbitrary admission form payload saved as JSON
  admission     Json?

  // Graduation tracking
  graduationDate DateTime?

  /**
   * The level we have already told this student they finished, e.g. "A1".
   * Stops the "your level is complete" notification firing again every time
   * the dashboard loads. Storing the level rather than a boolean means the
   * offer fires once per level, automatically, all the way up the ladder.
   */
  advanceOfferedFor String?

  /**
   * When this student finished (or skipped) the welcome tour.
   * Server-side rather than localStorage on purpose: a student who signs up on
   * a laptop and then opens the portal on their phone should not be walked
   * through the introduction a second time.
   */
  welcomeTourSeenAt DateTime?

  // ---------------------------------------------------------------------
  // The journey to Germany. See src/lib/germany-journey.ts.
  // ---------------------------------------------------------------------

  /**
   * The day this student actually walked into their first class.
   * THE COUNTDOWN RUNS FROM HERE, not from the batch month. A student who paid
   * in August but only started on 12 September has a level that ends in
   * November, and a portal that told them otherwise would be wrong on the one
   * date they care about most. Null until they confirm it (or until an
   * attendance row proves it, which confirms it for them).
   */
  classesStartedAt DateTime?

  /**
   * When they pressed the button. Separate from the date they reported.
   */
  startConfirmedAt DateTime?

  /**
   * How the start was established: "student" (they confirmed it), "attendance"
   * (their first register entry proved it), or "admin" (the office set it).
   */
  startConfirmedVia String?

  /**
   * "Not yet" pushes the daily prompt to tomorrow rather than killing it.
   */
  startPromptSnoozedUntil DateTime?

  /**
   * How many times they have answered "not yet", and the last reason given.
   * A student on their sixth "not yet" is a student the branch should call —
   * this is the churn signal the office never had.
   */
  notStartedCount  Int     @default(0)
  notStartedReason String?

  /**
   * When the OFFICE marked this student's level finished, and which level that
   * was. The "your level is complete, here is the next one" offer fires off
   * this and nothing else. It used to be derived from the batch month, which
   * congratulated students who had not attended a single lesson.
   */
  levelCompletedAt  DateTime?
  levelCompletedFor String?

  /**
   * A student the office will NOT sign off — failed assessment, unresolved
   * fees, whatever the reason. Without this, the cohort console's bulk
   * "select all not signed off" sweeps the same held-back name into every
   * batch forever, since nothing else distinguishes "not signed off yet" from
   * "not signed off, deliberately." heldBackAt null means not held back.
   */
  heldBackAt     DateTime?
  heldBackReason String?

  /**
   * Stages after the classroom — documents, visa, arrival — which no database
   * of ours can observe. The student reports them and the office may verify
   * them: { "visa": { "status": "claimed", "at": "...", "note": "..." } }
   */
  journeyStages Json?

  /**
   * Last time the once-a-day journey moment was shown. Per account, not per device.
   */
  journeySeenAt DateTime?

  /**
   * How often the student wants the road to open by itself.
   * "daily" (the default), "less" — every third day — or "never".
   * WHY THERE IS A MIDDLE OPTION. A popup with only "show me" and "never
   * again" is a popup most people turn off the first time it lands at a bad
   * moment, and then the best thing in the portal is gone forever over one
   * mistimed Tuesday. "Show less" is the answer to "not right now" that does
   * not cost the school the feature, and for the student it is the honest
   * version of what they meant. It is stored per ACCOUNT rather than per
   * device for the same reason journeySeenAt is: turning it off on a laptop
   * and meeting it again on a phone would read as the portal ignoring them.
   */
  journeyMomentPreference String @default("daily")

  /**
   * WHY they are learning German — one of the eight roads in
   * src/lib/germany-goals.ts ("study", "ausbildung", "care", "family", …).
   * The whole destination half of the map is generated from this: a nurse's
   * road ends in Anerkennung and a first shift, a student's in a blocked
   * account and a first lecture. Null means nobody has asked them yet, which
   * is a real and different state from "custom" — an unasked student gets the
   * generic road AND the question; a `custom` student has answered and does
   * not get asked again.
   */
  germanyGoal      String?
  /**
   * Their own words, when they chose "Something else". Read by the branch.
   */
  germanyGoalNote  String?
  germanyGoalSetAt DateTime?

  // Email tracking for scheduled reminders
  feeRemindersScheduled Json? // tracks which reminders (7d, 14d, 30d, locked) have been sent
  emailPreferences      Json? // user preferences for notification types

  /**
   * Admin override for the part-payment lock. A student who has paid the 60%
   * deposit but not the balance is locked out 30 days after classes start
   * (see PART_PAYMENT_LOCK_DAYS in src/lib/access.ts). Setting a future date
   * here — "payment plan agreed", "cheque in the post" — suppresses that lock
   * and the balance reminders until it passes. Null means no override.
   */
  paymentGraceUntil DateTime?

  /**
   * The cold-start seed for the personalised study plan — what the learner
   * said about how they like to learn before the portal had any behaviour to
   * go on. Shape: `{ format?: "watch"|"read"|"practice"|"mixed", pace?:
   * "short"|"standard"|"deep", setAt?: string }`. Read by
   * src/lib/learner-style.ts as a gentle prior; real behaviour overrules it
   * within a fortnight. Null until the student answers the one-question card
   * on the study-plan tab.
   */
  learningPreferences   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments           Enrollment[]
  progress              Progress[]
  grades                Grade[]
  completions           Completion[]
  personalizedPlan      PersonalizedPlan?
  skillMasteries        StudentSkillMastery[]
  examRegistrations     ExamRegistration[]
  attendances           Attendance[]
  notifications         Notification[]
  invoices              Invoice[]
  payments              Payment[]
  tuitionCharges        TuitionCharge[]
  paymentPlans          PaymentPlan[]
  assignmentSubmissions AssignmentSubmission[]
  privateClasses        PrivateClass[]
  privateClassSeries    PrivateClassSeries[]
  certificates          Certificate[]
  videoProgress         VideoProgress[]
  studentClassNotes     StudentClassNote[]
  convertedFromLead     Lead?
  journeyEvents         JourneyEvent[]
  liveInvites           LiveClassInvite[]
  quizGamePlays         QuizGamePlayer[]
  materialQuestAttempts MaterialQuestAttempt[]
  supportTickets        SupportTicket[]
  termsAcceptances      TermsAcceptance[]
  refundRequests        RefundRequest[]
  /**
   * Direct 1:1 thread with an assigned tutor. Only meaningful for classType=private.
   */
  tutorMessages         TutorMessage[]
  /**
   * What the tutor wrote up after each private session.
   */
  sessionNotes          SessionNote[]
  // Parent/guardian accounts linked to this student. Plural because more than
  // one guardian can watch the same child (father and mother, say), each with
  // their own login.
  // @deprecated see Parent.studentId / ParentStudent doc-comments.
  parentLinks           Parent[]
  /// Live source of truth for parent/guardian links. See ParentStudent.
  guardianLinks         ParentStudent[]
  /**
   * Set instead of the row being removed. See src/lib/prisma-guard.ts — the
   * client rewrites delete into an update on every model listed here, and
   * filters these rows out of ordinary reads, so the application behaves as
   * though the row is gone while the data is still on disk and restorable.
   */
  deletedAt             DateTime?

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model StudentSkillMastery {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill          String
  mastery        Float     @default(50)
  attempts       Int       @default(0)
  lastScore      Int?
  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenantId       String?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([studentId, skill])
  @@index([tenantId, skill, mastery])
}

/**
 * A parent or guardian's own account, created through its own signup form
 * rather than bolted onto the student's.
 * This is the account and the claimed link to a child — NOT the monitoring
 * screens (attendance, results, notifications) that read from it.
 * `studentId` is nullable and set by the office once they have checked the
 * child details the parent typed in against the real record, rather than
 * resolved automatically and trusted: a parent claiming to be somebody's
 * guardian is exactly the kind of claim that should not self-approve.
 * @deprecated `studentId`/`student` only ever held ONE child. Real families
 * often have more than one enrolled, so the actual link now lives in
 * `ParentStudent` (see `children` below), which the office and every
 * parent-facing route use. This column is kept one release cycle as a
 * rollback safety net and is no longer written by new code.
 */
model Parent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone String?

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  /// Every linked child. See ParentStudent — this is the live source of truth.
  children ParentStudent[]

  // As typed at signup. Kept even after `studentId` is linked, so the office
  // still has the original claim to check the link against.
  childName        String?
  childEmail       String?
  childStudentCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([tenantId])
}

/**
 * One parent linked to one child, office-approved. Replaces `Parent.studentId`
 * (single-child only) so a parent with several kids at the school sees all of
 * them from one account. Never created by parent self-service — always by an
 * admin, after checking the claim in `Parent.childName`/`childStudentCode`
 * against the real student record. See ParentShell / /api/parent/*.
 */
model ParentStudent {
  id       String @id @default(cuid())
  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  linkedAt DateTime @default(now())
  /// Admin User.id who made the link, for audit.
  linkedBy String?

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
  @@index([tenantId])
}

/**
 * One line in a student's story.
 * Every milestone they reach, every "not yet", every level the office closes.
 * It exists for two readers: the student, whose map shows their own history
 * back to them ("12 August — you walked into your first class"), and the
 * office, which can see that a whole batch has confirmed starting except four
 * people worth ringing.
 * Append-only by convention. Nothing here is the source of truth for state —
 * the Student columns are — so a lost row costs a line of narrative, never a
 * countdown.
 */
/**
 * Everything a model has ever produced, keyed by what it was asked.
 * This is the whole cost story. Generating a summary per student per page view
 * is roughly 1,300 model calls a day for this school; generating it once per
 * material and reading it back is about twenty. That difference is what makes
 * the AI affordable on a free tier or on the office machine, rather than
 * needing a rented server nobody wants to pay for monthly.
 * `key` is a hash of the task plus the exact input, so changing a material
 * naturally misses the cache and regenerates, while re-asking the same
 * question a thousand times costs one lookup.
 */
model AiCache {
  id String @id @default(cuid())

  /**
   * sha256 of `${task}:${input}`. Unique — the lookup is the point.
   */
  key String @unique

  /**
   * material_summary | material_quests | cohort_missions …
   */
  task String

  /**
   * The parsed result. Shape depends on the task.
   */
  value Json

  /**
   * Which model produced it, so a bad batch can be found and cleared.
   */
  model String?

  /**
   * Generation is slow and can fail. A row is written before the answer
   * arrives so two jobs cannot generate the same thing at once, and so a
   * failure is visible rather than looking like it was never attempted.
   * pending | ready | failed
   */
  status String  @default("ready")
  error  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([task, status])
}

model StudentAiUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String
  day       DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, day])
  @@index([tenantId, day])
}

model JourneyEvent {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /**
   * started | not-yet | stage-claimed | level-completed | level-advanced |
   * registered | paid
   */
  type String

  /**
   * The stage this concerns, e.g. "firstDay", "A1", "visa".
   */
  stage String?

  /**
   * One line, written for the student to read.
   */
  label  String
  detail String?

  /**
   * student | attendance | admin | system — who caused it.
   */
  source String @default("student")

  /**
   * When it happened in the real world, which is not always when it was recorded.
   */
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([studentId, occurredAt])
  @@index([tenantId])
}

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  location  String?
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status    String   @default("active")
  /**
   * physical | online. The online branch is a real branch — it has its own
   * cohorts, tutors, timetable, community space and fees, and every existing
   * branch+level query keeps working unchanged. This flag only drives the
   * differences that genuinely exist: no campus, a live room instead of a
   * classroom, and recordings as the safety net for a dropped connection.
   * Defaulted to physical so every branch created before this existed keeps
   * behaving exactly as it did.
   */
  mode      String   @default("physical")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students       Student[]
  notifications  Notification[]
  spaces         Space[]
  classSessions  ClassSession[]
  assignments    Assignment[]
  exams          Exam[]
  lecturers      Lecturer[]
  schoolHolidays SchoolHoliday[]
  leads          Lead[]
  recordings     ClassRecording[]
  liveSessions   LiveClassSession[]
  quizGames      QuizGame[]
  /**
   * Set instead of the row being removed. See src/lib/prisma-guard.ts — the
   * client rewrites delete into an update on every model listed here, and
   * filters these rows out of ordinary reads, so the application behaves as
   * though the row is gone while the data is still on disk and restorable.
   */
  deletedAt      DateTime?
}

model ExamRegistration {
  id String @id @default(cuid())

  /**
   * Null for an external candidate. The centre sits members of the public for
   * ÖSD, not only enrolled students, and requiring a Student row made that
   * impossible.
   */
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /**
   * The account that owns this booking — set for students AND candidates, so
   * "my exams" is a single query rather than two paths that can disagree.
   */
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /**
   * Details captured for candidates who are not students.
   */
  candidateName  String?
  candidateEmail String?
  candidatePhone String?

  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: SetNull)

  examName String
  examDate DateTime
  /**
   * registered | confirmed | cancelled | completed | no_show
   */
  status   String   @default("registered")
  notes    String?

  /**
   * unpaid | paid | waived — a seat is only held once the fee is settled.
   */
  paymentStatus    String  @default("unpaid")
  paymentReference String?
  amountPaid       Int?

  seatNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

