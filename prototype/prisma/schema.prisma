model Lecturer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialization String?
  bio            String?
  phone          String?

  photoUrl String?

  /**
   * Whether this tutor still teaches here: active | probation | on_leave |
   * inactive. See src/lib/lecturer-status.ts for what each one permits.
   * Defaults to active so every tutor who existed before this field keeps
   * working exactly as they did. An "inactive" tutor cannot sign in, but their
   * account, their marks and every class they ever taught stay on record —
   * this is the alternative to deleting somebody who leaves, which used to be
   * the only option and took their history with it.
   */
  status          String    @default("active")
  /**
   * Free text: "maternity leave until March", "contract ended".
   */
  statusNote      String?
  /**
   * When the status last moved, so the office can see how long it has held.
   */
  statusChangedAt DateTime?
  /**
   * full_time | part_time | contract | visiting. Null means unrecorded.
   */
  employmentType  String?
  /**
   * First day of teaching. Null on tutors created before this was recorded.
   */
  startedAt       DateTime?

  /**
   * The tutor's PRIMARY class: branch + level + session. Kept because a large
   * amount of existing code — the live room name, the community space, the
   * timetable editor's opening state — needs one concrete answer to "which
   * class is this?". Always mirrors the first entry of the arrays below, so
   * these three never disagree with the assignment.
   */
  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  level       String?
  sessionSlot String?

  /**
   * The full assignment, set by an ADMIN and only by an admin. One tutor can
   * teach at several branches, several levels, several sittings and several
   * batches, so each of these is a list rather than a column.
   * Stored as JSON string arrays rather than join tables: they are always read
   * as a whole, never queried across rows, and every one of them is a short
   * closed vocabulary. Null means "never assigned" and falls back to the three
   * primary columns above, so every tutor created before this existed keeps
   * exactly the class they had.
   */
  branchIds        Json? // Branch ids
  levels           Json? // ["A1", "A2"]
  sessionSlots     Json? // ["morning", "evening"]
  /// Explicit branch + level + sitting groups. When present, these prevent
  /// unrelated levels and sittings from being combined accidentally.
  assignmentGroups Json? // [{ branchId, level, sessionSlot }]
  classTypes       Json? // ["physical", "online", "private"]
  batches          Json? // ["January", … "December"]

  /**
   * Which optional areas of the portal this tutor may reach:
   * ["live_classes", "private_classes", "recordings"].
   * A DIFFERENT QUESTION FROM `classTypes` ABOVE, which is what they teach.
   * Not every tutor runs the video call — a school may have one person who
   * takes every live session while others prepare the material — and a tutor
   * who only teaches in a physical room may still need to watch recordings
   * back. See src/lib/lecturer-features.ts.
   * Null means all of them, so every tutor created before this keeps the
   * portal they had. An empty array is a real answer and means none.
   */
  features Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes            Class[]
  exams              Exam[]
  materials          Material[]
  students           Student[]
  classSessions      ClassSession[]
  assignments        Assignment[]
  privateClasses     PrivateClass[]
  privateClassSeries PrivateClassSeries[]
  liveSessions       LiveClassSession[]
  quizGames          QuizGame[]
  tutorMessages      TutorMessage[]
  sessionNotes       SessionNote[]
  /**
   * Set instead of the row being removed. See src/lib/prisma-guard.ts — the
   * client rewrites delete into an update on every model listed here, and
   * filters these rows out of ordinary reads, so the application behaves as
   * though the row is gone while the data is still on disk and restorable.
   */
  deletedAt          DateTime?

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

