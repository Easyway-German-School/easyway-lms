// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

/**
 * Postgres, because the app is deployed to Vercel and SQLite is a file.
 * A serverless function gets a read-only filesystem and a fresh container, so
 * a file-backed database is not slow there — it is absent. Every write would
 * fail, and the ones that appeared to succeed would vanish with the container.
 * `url` is the POOLED connection string and `directUrl` the direct one. That
 * split is not decoration: each invocation opens its own connection, and a few
 * hundred concurrent students would exhaust a Postgres server's connection
 * limit within a minute without a pooler in front. Migrations, meanwhile,
 * cannot run through a pooler in transaction mode, which is what `directUrl`
 * is for. Neon and Supabase both hand you the two strings; if yours does not,
 * set both to the same value and keep an eye on connection count.
 */
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  password          String
  role              Role      @default(STUDENT)
  tenantId          String?
  tenant            Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  /**
   * Which kind of admin, when role is ADMIN: super | secretary | data_comm.
   * Null for everyone else. Deliberately a separate field rather than more
   * Role values, so every existing auth check on ADMIN keeps working and
   * existing admins keep full access by defaulting to super.
   */
  adminRole         String?
  /**
   * Platform operator, above every tenant rather than inside one.
   * `super` on adminRole means "runs this school". This means "runs the
   * platform the schools are on" — creates tenants, issues API keys, reads the
   * cross-tenant billing view. A separate field because the two are genuinely
   * different jobs: EasyWay's own super admin must NOT be able to read another
   * school's students by virtue of running EasyWay.
   * Null for everyone, including every existing admin. It is granted by hand
   * and there is deliberately no screen that grants it.
   */
  platformRole      String?
  /**
   * Per-person overrides on top of the sub-role's preset, as JSON:
   * { "grant": ["payments"], "revoke": ["staff"] }
   * Null means "just the preset", which is what every existing admin has, so
   * nobody's access changes until somebody deliberately ticks a box. Kept as
   * a diff rather than a flat capability list so that widening a preset later
   * still reaches the people on it.
   */
  adminCapabilities Json?
  /**
   * Set by a super admin to invalidate this admin's existing sessions.
   */
  adminLockedAt     DateTime?
  /**
   * Last authenticated presence heartbeat from an admin browser.
   */
  adminLastSeenAt   DateTime?
  /**
   * Restricts an admin to specific branches, as JSON: ["branchId1", "branchId2"].
   * Null (or an empty array) means unrestricted — every branch, exactly the
   * behaviour every admin had before this column existed — so nobody's access
   * narrows until a super admin deliberately picks branches for them. Only
   * meaningful alongside the `branches` capability; it does not grant that
   * capability by itself, it only narrows it once granted.
   */
  adminBranchIds    Json?
  /**
   * False on an account created by an exam booking, which starts with a
   * password nobody knows. The claim link works only while this is false, so
   * a forwarded confirmation email cannot be used to take the account later.
   */
  passwordClaimed   Boolean   @default(true)

  passwordResetTokens PasswordResetToken[]

  /**
   * The TOTP shared secret, encrypted at rest. See src/lib/mfa.ts.
   * Encrypted rather than stored plainly because a secret sitting in the clear
   * makes the second factor worth nothing against the attack it exists to
   * stop: whoever reads this table can already read the password hashes, and
   * with the raw secret alongside they can mint valid codes forever. The key
   * lives in the environment, so the database alone is not enough.
   * Set at enrolment, before the first code is confirmed. Possession of a
   * secret is therefore NOT proof that two-factor is on — `totpEnabledAt` is.
   */
  totpSecret      String?
  /**
   * When the first correct code was entered. Null means not enrolled.
   */
  totpEnabledAt   DateTime?
  /**
   * One-time recovery codes, stored as bcrypt hashes and never shown again
   * after enrolment. A lost phone must not mean a lost school.
   */
  totpBackupCodes Json?
  /**
   * The last time-step accepted for this account.
   * A TOTP code stays valid for its whole window, so one shoulder-surfed or
   * intercepted code can be replayed within the same half-minute. Refusing any
   * step at or below this one makes every code strictly single-use.
   */
  totpLastStep    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student            Student?
  lecturer           Lecturer?
  parent             Parent?
  sessions           Session[]
  missionProgress    MissionProgress[]
  dailyMissions      DailyMission[]
  messages           Message[]
  moderatedMessages  Message[]                @relation("MessageModerator")
  pinnedMessages     Message[]                @relation("MessagePinner")
  messageReactions   MessageReaction[]
  communityMute      CommunityMute?           @relation("MutedMember")
  mutesIssued        CommunityMute[]          @relation("MuteAuthor")
  channelReads       ChannelRead[]
  pushSubs           PushSubscription[]
  examRegistrations  ExamRegistration[]
  notifications      Notification[]           @relation("NotificationRecipient")
  notificationPrefs  NotificationPreference[]
  sentNotifications  Notification[]           @relation("NotificationSender")
  proposedActions    AdminAction[]            @relation("AdminActionCreator")
  executedActions    AdminAction[]            @relation("AdminActionExecutor")
  auditEvents        AuditLog[]               @relation("AuditActor")
  auditRestores      AuditLog[]               @relation("AuditRestorer")
  supportTickets     SupportTicket[]          @relation("SupportTicketAuthor")
  assignedTickets    SupportTicket[]          @relation("SupportTicketAssignee")
  supportReplies     SupportTicketMessage[]
  gameMatches        GameMatch[]
  gameTurnsAssigned  GameTurn[]               @relation("GameTurnAssignee")
  gameTurnsWritten   GameTurn[]               @relation("GameTurnAuthor")
  constraintDecks    ConstraintDeck[]
  sentTutorMessages  TutorMessage[]
  studentAiUsage     StudentAiUsage[]
  betaFeedback       BetaFeedback[]
  learnerUsage       LearnerUsageEvent[]
  behaviourProfile   LearnerBehaviourProfile?
  termsAcceptances   TermsAcceptance[]
  refundRequests     RefundRequest[]          @relation("RefundRequestStudent")
  refundsDecided     RefundRequest[]          @relation("RefundRequestDecider")
  analyticsConsentAt DateTime?
  /**
   * Set only when the person has ASKED to be left out of learning analytics.
   * `analyticsConsentAt` above cannot express this: null there means "never
   * joined the beta programme", which is the state almost everybody is in, and
   * treating that as a refusal is how the school ended up with usage data on
   * a handful of volunteers and none on the other two hundred students it is
   * responsible for. An explicit column means an explicit refusal.
   */
  analyticsOptOutAt  DateTime?

  /**
   * Set instead of the row being removed. See src/lib/prisma-guard.ts — the
   * client rewrites delete into an update on every model listed here, and
   * filters these rows out of ordinary reads, so the application behaves as
   * though the row is gone while the data is still on disk and restorable.
   */
  deletedAt DateTime?
}

