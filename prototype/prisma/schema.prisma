/// ONE ROW PER LEVEL A STUDENT PASSES THROUGH — the debit side of tuition.
///
/// Before this, "what does a student owe" was `tuitionFeeFor(currentLevel) -
/// sum(every payment ever)` (src/lib/finance/receivables.ts). That only ever
/// looked at the CURRENT level, so the moment `promoteStudents` bumped
/// `Student.level` the previous level's shortfall dropped out of the maths and
/// cumulative payments netted against the new level's fee. A student could ride
/// A1 -> B1 on part-payments and finish owing money nobody could see.
///
/// Now every level entered (signup, promotion, a next-level payment, an admin
/// adjustment, a CSV import, or the one-time backfill) leaves a `TuitionCharge`
/// with the fee FROZEN at creation. Payments are allocated across the open
/// charges oldest-first (FIFO) by src/lib/finance/ledger.ts — nothing is stored
/// per allocation, it is recomputed on read like the rest of the finance layer.
///
/// `amount` is WHOLE NAIRA, same convention as `Payment.amount`.
model TuitionCharge {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// The level this charge is for, e.g. "A1". One charge per level per student
  /// (see the unique index) — mirrors how Certificate is keyed.
  level  String
  /// Fee owed for this level, frozen when the charge was created. A later price
  /// change or branch retier must never move a charge already on the ledger.
  amount Int

  /// Snapshots of how the student attended when the charge was raised, so the
  /// figure can be explained later without re-deriving it from current state.
  classType  String  @default("group")
  branchName String?

  /// How the charge came to exist: signup | promotion | next_level_payment |
  /// admin | import | backfill.
  origin String

  /// True for a lower level a student had already passed BEFORE the ledger
  /// existed, created by the cutover backfill. Legacy arrears are fully visible
  /// and chased, but they do NOT trip the automatic portal lock and do NOT
  /// hard-block promotion — the student never agreed to these rules mid-course.
  legacyArrears Boolean @default(false)

  /// A scholarship or negotiated write-off. `amount - waivedAmount` is what the
  /// student is actually expected to pay; allocation and every rollup use the
  /// net figure.
  waivedAmount Int     @default(0)
  waivedReason String?

  note      String?
  createdAt DateTime  @default(now())
  /// Set the first time FIFO allocation fully covers this charge. Advisory —
  /// the authoritative "is it settled" answer is recomputed on read.
  settledAt DateTime?

  /**
   * Set instead of the row being removed. See src/lib/prisma-guard.ts.
   */
  deletedAt DateTime?

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([studentId, level])
  @@index([studentId])
  @@index([tenantId])
}

/// A negotiated instalment schedule for a student's tuition balance.
///
/// This is the FIRST-CLASS version of what `Student.paymentGraceUntil` did by
/// hand: while a plan is `active` and the student is keeping to it, the 30-day
/// part-payment lock is suppressed and the balance-reminder ladder is held —
/// exactly like a grace date, but tracked. Miss an instalment past its own
/// short grace and the plan goes `defaulted`: the lock and the reminders come
/// straight back and the accountant is notified.
///
/// `installments` is the schedule as JSON: `[{ "dueOn": ISO, "amount": naira,
/// "paidAt"?: ISO }]`. Adherence is judged by comparing the sum due by `now`
/// against the student's received payments since the plan started — a specific
/// Payment row is not tied to a specific instalment, because a student paying
/// ₦20k a week just needs the running total to keep up.
model PaymentPlan {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// The TuitionCharge ids this plan is meant to clear, oldest-first. Advisory
  /// — FIFO allocation still decides what each payment actually settles.
  chargeIds Json

  /// [{ dueOn, amount, paidAt? }] — see the note above.
  installments Json

  /// active | completed | defaulted | cancelled
  status String @default("active")

  /// How many days after an instalment's dueOn before a shortfall counts as a
  /// default. Keeps a payment that lands a day late from tripping the lock.
  graceDays Int @default(3)

  /// Naira paid toward tuition at the moment the plan was created — the
  /// baseline adherence is measured from.
  startingPaid Int @default(0)

  createdById String?
  note        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  defaultedAt DateTime?
  completedAt DateTime?
  deletedAt   DateTime?

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([tenantId])
}

