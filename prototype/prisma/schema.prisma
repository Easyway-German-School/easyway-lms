   * Set instead of the row being removed. See src/lib/prisma-guard.ts — the
   * client rewrites delete into an update on every model listed here, and
   * filters these rows out of ordinary reads, so the application behaves as
   * though the row is gone while the data is still on disk and restorable.
   */
  deletedAt DateTime?

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Exam {
  id       String  @id @default(cuid())
  // Optional: an ÖSD sitting the centre hosts belongs to no course and has no
  // assigned lecturer, while an internal course test has both.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  name        String
  description String?
  examDate    DateTime
  totalScore  Int      @default(100)

  /**
   * ÖSD | telc | internal — who awards the certificate.
   */
  examBody String  @default("internal")
  /**
   * CEFR level the sitting is for.
   */
  level    String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  /**
   * Fee in kobo-free naira. Null means no fee (internal tests).
   */
  fee Int?

  /**
   * Seats available. Null means uncapped.
   */
  capacity             Int?
  registrationDeadline DateTime?

  /**
   * Only published sittings are bookable by candidates.
   */
  published       Boolean @default(false)
  resultsReleased Boolean @default(true)

  /**
   * Per-skill minimum (0-100) to pass this sitting. A candidate passes only
   * if every one of the four skill scores clears this bar — matching real
   * ÖSD/Goethe grading, where one weak skill fails the sitting regardless of
   * how strong the others are.
   */
  passThreshold Int @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades        Grade[]
  registrations ExamRegistration[]

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([published, examDate])
  @@index([tenantId])
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
  /**
   * Registered for an exam only — no classes, materials or community.
   */
  CANDIDATE
  /**
   * A parent or guardian, signed up through their own form rather than the
   * student's. Read-only by design once the monitoring screens are built —
   * see the Parent model above.
   */
  PARENT
}

// ---------------------------------------------------------------------------
// Community hub (Discord-style channels + Reddit-style threads).
// A Space is scoped to one branch AND one level, so "Lagos · A1" and
// "Abuja · A1" are separate communities even though the syllabus matches.
// ---------------------------------------------------------------------------

/**
 * A cohort's community, keyed on the three things that actually make a cohort.
 * `sessionSlot` joined the key because branch + level was never a class. Lagos
 * runs A1 in the morning, the afternoon and the evening as three separate
 * classes with three different tutors and three sets of students who never meet
 * — and they were all being dropped into one shared room, where a morning
 * student saw questions about an evening lesson they had not sat and answers
 * from a tutor who is not theirs.
 * Adding it to the unique key is what makes the separation real rather than a
 * filter somebody can forget to apply: there is now exactly one space per
 * (branch, level, sitting), and a student resolves to theirs and to no other.
 */
model Space {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  level       String
  sessionSlot String   @default("morning")
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channels    Channel[]
  gameMatches GameMatch[]

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([branchId, level, sessionSlot])
  @@index([tenantId])
}

model Channel {
  id          String   @id @default(cuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  kind        String   @default("topic")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages Message[]
  reads    ChannelRead[]

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([spaceId, slug])
  @@index([tenantId])
}

/**
 * Per-member read marker. Unread = threads in the channel whose lastActivityAt
 * is newer than lastReadAt. One row per (user, channel); absence means the
 * member has never opened the channel, so everything in it counts as unread.
 */
model ChannelRead {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
  @@index([tenantId])
}

/**
 * A browser push endpoint (Web Push / VAPID). A member may have several — one
 * per device or browser — so the key is the endpoint, not the user.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

/**
 * One message in a cohort's group chat.
 * THIS REPLACED Thread + Comment, AND THE REASON IS NOT TIDINESS.
 * The old shape was a forum: you opened a thread with a title, people replied
 * underneath, and the reply tree could nest without limit. Students did not use
 * it, and the reason is obvious in hindsight — nobody composes a titled post to
 * ask "was there homework?". They send a message. A forum asks you to decide
 * where your sentence belongs before you are allowed to say it, and that one
 * demand is enough to stop most people posting at all.
 * So a channel is now a running conversation, in time order, exactly like the
 * app every one of these students already has open on their phone.
 * - `replyToId` is a QUOTE, not a branch. WhatsApp quotes one message and
 * renders it above the reply; it never nests. The old `CommentChildren`
 * self-relation could nest forever, which reads as a wall of indentation on
 * a 375px screen — the width most of this school actually uses.
 * - `hiddenAt` rather than a delete. The school has to be able to take a
 * message off the wall without destroying the evidence that it was sent,
 * because the times you most need to remove something are exactly the times
 * somebody will later ask what it said.
 * - `attachmentUrl` is one optional image. Students photograph their homework;
 * a chat that cannot carry that is a chat they will abandon for WhatsApp,
 * which is the outcome this whole feature exists to prevent.
 */
model Message {
  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body String

  /**
   * The message this one quotes. Null for an ordinary message.
   */
  replyToId String?
  replyTo   Message?  @relation("MessageQuote", fields: [replyToId], references: [id], onDelete: SetNull)
  quotedBy  Message[] @relation("MessageQuote")

  /**
   * One optional image or file, stored through the shared upload path.
   */
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?

  /**
   * Moderation, kept as a soft hide. A hidden message stops rendering for
   * students and stays fully readable to staff, with who hid it and why.
   */
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenBy     User?     @relation("MessageModerator", fields: [hiddenById], references: [id], onDelete: SetNull)
  hiddenReason String?

  /**
   * Set when the author edits, so the bubble can say so rather than lie.
   */
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  reactions MessageReaction[]

  /**
   * A sticker from the school's own set, sent instead of text.
   * An ID, never an image URL. The artwork is drawn in code (see
   * src/lib/community-stickers.tsx), so a sticker sent today still renders
   * after the set is redrawn, costs no storage, and cannot 404 the way an
   * uploaded file eventually does.
   */
  stickerId String?

  /**
   * "text" for everything ordinary; "game_invite" when this message IS the
   * card inviting the room to a game. A discriminator rather than inferring
   * the kind from which optional field is set, the way stickerId/attachment
   * already are — a game invite needs the reader to render one specific
   * bubble, not "whichever special field happens to be non-null", and a
   * second special type sharing that inference would make the two ambiguous
   * the moment a message somehow carried both.
   */
  kind String @default("text")

  /**
   * Set only on a "game_invite" message. Points at the GameMatch this card
   * invites the room into — started through the ordinary POST /api/games the
   * same way a game started from the Games tab is, so there is exactly one
   * way a match ever comes into existence. onDelete: SetNull rather than
   * Cascade: a match being archived should not delete the historical fact
   * that it was started from this thread.
   */
  gameMatchId String?
  gameMatch   GameMatch? @relation(fields: [gameMatchId], references: [id], onDelete: SetNull)

  /**
   * Staff pinning something to the top of the room. Null for the vast majority.
   * A pin is not moderation — it is the opposite. Removal takes a message away;
   * a pin is how "the exam is on the 14th" stops being buried under two hundred
   * lines of chat by Tuesday.
   */
  pinnedAt   DateTime?
  pinnedById String?
  pinnedBy   User?     @relation("MessagePinner", fields: [pinnedById], references: [id], onDelete: SetNull)

  /**
   * The read cursor and the poll both order by this, and both need the newest
   * page of one channel cheaply. It is the only access pattern that matters.
   */
  @@index([channelId, createdAt])
  /// Finding the handful of pinned messages in a room without scanning it.
  @@index([channelId, pinnedAt])
  @@index([authorId])
  @@index([tenantId])
}

/// One person's one reaction to one message.
///
/// A row per person per emoji rather than a counter on the message, because
/// the question the UI actually asks is "did *I* react, and with what" — that
/// is what decides whether tapping the pill adds or removes, and a bare count
/// cannot answer it. It also makes "who reacted" a query rather than a
/// redesign.
///
/// The unique constraint is what makes the toggle safe to double-tap: a second
/// identical reaction cannot be stored, so an impatient tap on a slow phone
/// cannot inflate the count.
/// A student the office has stopped from posting, until a moment in time.
///
/// A mute, not a ban, and that distinction is the whole design. The student
/// keeps reading — they stay in their class group, they still get the
/// announcements and the homework — they simply cannot post until it lapses.
/// Removing them from the room would cut them off from their class over a
/// behaviour problem, which is a punishment the school did not intend.
///
/// It EXPIRES rather than being switched off by hand. A mute nobody remembers
/// to lift is a silent, permanent exclusion, and the person who set it is
/// usually not the person on duty when it should end.
model CommunityMute {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("MutedMember", fields: [userId], references: [id], onDelete: Cascade)

  /// When posting comes back. Always set; there is no indefinite mute.
  mutedUntil DateTime

  /// Shown to the muted student, so a silence is never unexplained.
  reason String?

  mutedById String?
  mutedBy   User?   @relation("MuteAuthor", fields: [mutedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([mutedUntil])
}

model MessageReaction {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The emoji itself, stored as the character. Small, portable, and it needs
  /// no lookup table to render.
  emoji String

  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Timetable overlay.
//
// src/lib/schedule.ts generates the SKELETON of a term from the batch/level
// rotation — which days a cohort meets. That skeleton is deterministic and has
// no database behind it. This model is the human layer on top: the real topic
// a tutor is teaching that day, the actual clock times, whether the class got
// postponed, and which material to bring.
//
// A row is created only when someone edits a day, so an untouched timetable
// costs nothing and the generator stays the source of truth for WHICH days a
// cohort meets.
// ---------------------------------------------------------------------------

model ClassSession {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  level    String

  /**
   * Midnight UTC on the day of the class — the join key back to the skeleton.
   */
  date     DateTime
  /**
   * morning | afternoon | evening — the branch runs all three.
   */
  timeSlot String   @default("morning")

  startTime String? // "09:00"
  endTime   String? // "11:00"

  /**
   * The day's topic, editable by the tutor and visible to students.
   */
  topic String?
  notes String?

  /**
   * scheduled | postponed | cancelled | held
   */
  status      String    @default("scheduled")
  postponedTo DateTime?

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  /**
   * Live-room override. The room name is normally derived from branch + level
   * + date + slot (see lib/live-classroom.ts) so no row is needed for a class
   * to be joinable; this only exists for the case where a tutor moves a
   * session into an existing room, or pins a permanent one.
   */
  roomName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([branchId, level, date, timeSlot])
  @@index([branchId, level, date])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Assignments: documents to hand in, and timed quizzes.
//
// Quiz questions and answers live in JSON rather than their own tables. The
// shape is small, always read as a whole, and never queried across rows — a
// question has no meaning outside its quiz — so tables would buy nothing.
// ---------------------------------------------------------------------------

model Assignment {
  id       String  @id @default(cuid())
  level    String
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  /**
   * Which sitting this is for. NULL means every sitting at the level, which is
   * how assignments behaved before sessions became a real boundary — so
   * existing rows keep reaching exactly who they always did.
   * It matters because a branch runs the same level three times a day with
   * three different tutors. Homework set by the morning tutor landing on the
   * evening class's dashboard is the same mistake the community and the live
   * classroom already had to fix: work from a lesson those students never sat.
   */
  sessionSlot String?

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  title       String
  description String?

  /**
   * document | quiz
   */
  type String @default("document")

  /**
   * Quizzes only. Null means untimed.
   */
  timeLimitMinutes Int?

  /**
   * Quizzes only. An array of questions, each tagged with its own `type`:
   * choice | multi | boolean | short | paragraph. See src/lib/assignments.ts
   * for the shape of each and for the parser, which reads a question with no
   * `type` as multiple choice so every quiz written before the other types
   * existed keeps working.
   */
  questions Json?

  dueAt     DateTime?
  published Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions AssignmentSubmission[]
  /// Live games played off this quiz. The game snapshots the questions, so
  /// editing this row never rewrites history for a game already played.
  quizGames   QuizGame[]
  /**
   * Named recipients. EMPTY MEANS EVERYONE at this level and branch, which is
   * how every assignment written before this behaved and still behaves — the
   * targeted case is the addition, not the new default. Setting even one
   * target narrows the assignment to exactly that list.
   */
  targets     AssignmentTarget[]

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([level, branchId])
  @@index([tenantId])
}

/**
 * One named student who should get one assignment.
 * A join table rather than a JSON array of ids on Assignment, because the
 * question actually asked is "what has this student been set?" — which is an
 * indexed lookup here and a full scan with JSON matching there. It also means
 * the database refuses a target pointing at a student who no longer exists,
 * rather than leaving an id that silently matches nobody.
 */
model AssignmentTarget {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([tenantId])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /**
   * Documents: the written answer and/or an uploaded file.
   */
  text     String?
  filePath String?
  fileName String?

  /**
   * Quizzes: the chosen option index per question.
   */
  answers Json?

  score    Int?
  feedback String?

  /**
   * Per-question marks, as returned by gradeSubmission: the auto marks are
   * written at submission time and the hand marks folded in later.
   * Kept so a student can be shown which questions they lost marks on rather
   * than a bare percentage, and so a disputed mark can be re-read months later
   * without re-running a grader whose rules may have changed since.
   */
  questionScores Json?

  /**
   * True while a written answer is still waiting for a tutor.
   * `score` stays null the whole time it is set. A part-marked paper must not
   * show a percentage — a student who wrote a good essay seeing 40% because
   * only the vocabulary section has been marked will read it as a fail.
   */
  needsReview Boolean @default(false)

  markedById String?
  markedAt   DateTime?

  /**
   * platform | physical — paper submissions are recorded by a tutor.
   */
  submissionMode String @default("platform")

  /**
   * Set when a timed quiz is opened. The deadline is derived from this on the
   * server, so a student cannot win time by reloading or editing the clock.
   */
  startedAt   DateTime?
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Outbound email pipeline.
//
// Mail is queued rather than sent inline: a bulk send to every unpaid student
// cannot block a request, and a provider hiccup must not lose the message.
// A worker drains the queue with backoff, and Suppression records addresses
// that must never be written to again.
// ---------------------------------------------------------------------------

model EmailMessage {
  id String @id @default(cuid())

  to      String
  subject String
  html    String
  /**
   * welcome | fee_reminder | exam_reminder | bulk | ...
   */
  type    String @default("general")

  studentId String?

  /**
   * queued | sending | sent | failed | suppressed | cancelled
   */
  status    String  @default("queued")
  attempts  Int     @default(0)
  lastError String?

  /**
   * Not sent before this time; drives reminders and scheduled campaigns.
   */
  scheduledFor DateTime  @default(now())
  sentAt       DateTime?

  /**
   * Groups the messages produced by one bulk send.
   */
  campaignId String?

  /**
   * Which of the school's two sending identities this message goes out as:
   * "support" (a human reads replies) or "noreply" (automated receipts).
   * Stored per message rather than read from env at send time, because a
   * queued message may not drain until after a config change and it must go
   * out as the address it was composed under. See src/lib/mail-identity.ts.
   */
  identity String @default("noreply")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([campaignId])
  @@index([tenantId])
}

/**
 * Which notification kinds are allowed to leave the building, and how.
 * One row per kind. Absent means "use the code default", so the table starts
 * empty and the system behaves exactly as it did before anybody opens the
 * settings page — an admin turning one thing off must not require seventeen
 * rows to exist first.
 */
/**
 * The wording, signatories and colours printed on a certificate.
 * One row per school. Everything the document says other than the student's own
 * facts lives here, so the office can correct an address, rename a signatory or
 * reword the citation without a deploy — the previous template had all of it
 * hardcoded in the component, which meant a change of Head of Department was a
 * code change.
 * Stored as a single JSON blob rather than thirty columns. The shape is small,
 * always read as a whole, never queried across rows, and every field is a
 * string — so columns would buy nothing and cost a migration each time the
 * design gains a line. Parsed and merged over the defaults by
 * src/lib/certificate-template.ts, which means a half-filled row still renders
 * a complete document.
 */
model CertificateTemplate {
  id  String @id @default(cuid())
  /**
   * Reserved for future named templates; today there is one, "default".
   */
  key String @default("default")

  settings Json?

  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([key])
}

model NotificationSetting {
  id String @id @default(cuid())

  /**
   * A KIND value from src/lib/notify.ts, e.g. "payment.received".
   */
  kind String @unique

  /**
   * The in-app bell. Off means the notification is not created at all.
   */
  inApp Boolean @default(true)
  /**
   * Browser/device push, for the ones that mean "look now".
   */
  push  Boolean @default(true)
  /**
   * A copy by email, sent through the queue.
   */
  email Boolean @default(true)

  /**
   * Which sender an emailed copy uses — "support" or "noreply". Null follows
   * the code's default for this kind.
   */
  identity String?

  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/**
 * One person's own answer to "stop sending me this".
 * SEPARATE FROM NotificationSetting, and the distinction matters. That table
 * is the school's policy — an admin deciding that payment receipts email. This
 * one is a tutor deciding they would rather not have their phone buzz for
 * every material a colleague publishes. Merging them would mean a tutor
 * muting something for the whole school, which is not a preference, it is an
 * outage.
 * A row can only ever NARROW the school's plan (see mutedChannelsFor in
 * src/lib/notification-prefs.ts). Absent means "everything the policy allows",
 * so the table starts empty and nobody's delivery changes until they say so.
 */
model NotificationPreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * A KIND value from src/lib/notification-kinds.ts.
   */
  kind String

  /**
   * False mutes this channel for this person and this kind.
   */
  inApp Boolean @default(true)
  push  Boolean @default(true)
  email Boolean @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /**
   * One row per person per kind — the upsert target.
   */
  @@unique([userId, kind])
  @@index([userId])
  @@index([tenantId])
}

model EmailSuppression {
  id     String  @id @default(cuid())
  email  String  @unique
  /**
   * bounced | complained | unsubscribed | manual
   */
  reason String
  note   String?

  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Private (one-to-one) classes.
//
// A private student has no branch+level timetable to generate from, so their
// calendar is these rows and nothing else. Kept separate from ClassSession
// because that model is keyed on branch + level + slot — the exact thing a
// private class does not have.
// ---------------------------------------------------------------------------

model PrivateClass {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  scheduledAt     DateTime
  durationMinutes Int      @default(60)
  topic           String?
  /**
   * scheduled | completed | cancelled | postponed | requested | declined |
   * cancel_requested | reschedule_requested | skipped
   * The last two are series-generated rows: `skipped` is a holiday the series
   * engine matched and did not book, kept as a row (not silently omitted) so
   * the calendar can say why nothing is there that day. `reschedule_requested`
   * pairs with `proposedAt` below — the row's own `scheduledAt` stays the
   * CURRENT booked time until staff approve the move.
   */
  status          String   @default("scheduled")
  notes           String?

  /**
   * physical | online | hybrid, or null to inherit the student's own
   * `Student.deliveryMode`. A session-level override exists because a
   * usually-online student can still come in for one physical session (an
   * exam prep sitting, say) without changing their standing delivery mode.
   */
  deliveryMode String?
  location     String?

  /**
   * present | absent | late | no_show. Null until marked — see
   * src/lib/private-classes.ts for how this is derived (LiveClassInvite
   * status for an online session) versus set by hand (a physical one, which
   * has no invite row to read).
   */
  attendanceStatus String?
  attendanceNote   String?

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  /**
   * Which recurring series generated this occurrence, if any. A row with no
   * seriesId was booked one-off, exactly like today.
   */
  seriesId String?
  series   PrivateClassSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  /**
   * True the moment anyone edits THIS occurrence directly (time, status,
   * tutor, topic) rather than through the series. Once set, regenerating or
   * editing the series never touches this row again — an exception is a fact
   * about one date, not a standing disagreement with the pattern.
   */
  isException Boolean @default(false)

  /**
   * The student's proposed new time while status is `reschedule_requested`.
   */
  proposedAt DateTime?

  sessionNotes SessionNote[]
  recordings   ClassRecording[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([seriesId, scheduledAt])
  @@index([studentId, scheduledAt])
  @@index([tenantId])
}

/**
 * A standing weekly (or twice-weekly) booking pattern for a private student.
 * This does NOT hold the calendar itself — it is the recipe. The actual
 * bookable rows are materialised `PrivateClass` occurrences with `seriesId`
 * set, generated on a rolling window (see src/lib/private-class-series.ts),
 * so a single occurrence can be edited, cancelled or skipped for a holiday
 * without touching the pattern everyone else still meets on.
 */
model PrivateClassSeries {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  /**
   * JSON array of lowercase weekday names, e.g. `["monday","thursday"]`.
   * One entry is "weekly", two is "twice weekly" — the frequency is simply
   * the count, so nothing else needs to track it separately.
   */
  weekdays        Json
  startTime       String
  durationMinutes Int    @default(60)

  deliveryMode String?
  location     String?
  topic        String?

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  /**
   * IANA name, e.g. "Africa/Lagos" — carried onto every generated occurrence's context.
   */
  timezone String @default("UTC")

  startDate DateTime
  /**
   * Null means indefinite — keep generating until the series is ended.
   */
  endDate   DateTime?

  /**
   * active | paused | ended. Paused stops generating new occurrences without
   * discarding the pattern (a student on a break); ended is terminal.
   */
  status String @default("active")

  /**
   * "admin" | "tutor" — who set this pattern up, shown on the review screen.
   */
  createdBy String?

  occurrences PrivateClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([tenantId])
}

/**
 * A date the school does not book private classes on — Christmas, a public
 * holiday, a branch-specific closure. The series generator (see
 * src/lib/private-class-series.ts) checks every date it would otherwise book
 * against this table and writes a `skipped` occurrence instead of a real one.
 */
model SchoolHoliday {
  id    String   @id @default(cuid())
  date  DateTime
  label String

  /**
   * Null applies to every branch; set applies to just that one.
   */
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([tenantId])
}

/**
 * The private-tier DM: one thread per (student, tutor) pair, not scoped
 * through the branch/level Community spaces at all — a 1:1 coaching
 * relationship isn't a room, and forcing it through Channel/Space would
 * borrow moderation and read-tracking built for a cohort chat, not a pair.
 */
model TutorMessage {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tutorId String
  tutor   Lecturer @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  /**
   * Whichever side actually sent it — the student's User or the tutor's User.
   */
  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body String

  readByStudentAt DateTime?
  readByTutorAt   DateTime?

  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([tutorId, createdAt])
  @@index([tenantId])
}

/**
 * The tutor's write-up after a private session — the tangible proof of what
 * the 1:1 relationship actually covered, shown back to the student and to
 * whoever pays the invoice. Deliberately separate from PrivateClass.notes,
 * which is the tutor's own scheduling scratch pad: this is written FOR the
 * student to read.
 */
model SessionNote {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tutorId String
  tutor   Lecturer @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  privateClassId String?
  privateClass   PrivateClass? @relation(fields: [privateClassId], references: [id], onDelete: SetNull)

  summary String

  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// "Is class happening right now?"
//
// Nothing in this schema could answer that before. A room name is derived from
// branch + level + slot, so it exists whether or not anybody is in it — which
// is fine for building a URL and useless for telling a student their tutor has
// arrived. A student's only way to find out was to open /live and look at an
// empty room, which teaches them to stop checking.
//
// A LiveClassSession row IS the answer. It is opened when the tutor joins,
// closed when they leave, and while it is open every way a student might hear
// about the class — the bell, their phone, the dashboard, a code typed on a
// friend's laptop — reads from this one row.
// ---------------------------------------------------------------------------

model LiveClassSession {
  id String @id @default(cuid())

  /**
   * The LiveKit/Jitsi room this session is happening in. NOT unique: the same
   * cohort room is used again next week, and the history of who taught when is
   * worth keeping. "Live now" means `endedAt IS NULL`, not "a row exists".
   */
  roomName String

  /**
   * Short human code — "K7QP2M" — for the student whose email did not arrive,
   * or who is on a phone and will not type a URL. Unique across ALL sessions
   * including ended ones, so a code can never be recycled into a different
   * class while somebody still has it written down.
   */
  joinCode String @unique

  /**
   * cohort | private. A cohort session reaches a whole roster; a private one
   * reaches exactly the students on its invite list and nobody else.
   */
  kind String @default("cohort")

  /**
   * What the student sees in the popup: "Lagos · A1 · Morning".
   */
  title String

  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  level       String?
  sessionSlot String?

  /**
   * Set on a one-to-one session, pointing back at the booking.
   */
  privateClassId String?

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  /**
   * The account that opened it, which is not always a Lecturer row.
   */
  startedByUserId String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  /**
   * Touched by the tutor's heartbeat. A browser that crashes never sends the
   * "I left" call, so without this a session stays open forever and the
   * dashboard tells students to join a class that finished on Tuesday. Anything
   * not seen for a few minutes is treated as over — see lib/live-presence.ts.
   */
  lastSeenAt DateTime @default(now())

  invites LiveClassInvite[]

  /// Games played inside this lesson, so the recap can say what the class scored.
  quizGames QuizGame[]

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([roomName, endedAt])
  @@index([endedAt, lastSeenAt])
  @@index([branchId, level, sessionSlot, endedAt])
  @@index([tenantId])
}

/**
 * One student, singled out.
 * For a private class this is the guest list and the access control at once —
 * the token minter refuses anybody without a row here. For a cohort class it is
 * optional and means something softer: "the tutor rang this person", which is
 * how a tutor pulls three students into a catch-up without notifying forty.
 */
model LiveClassInvite {
  id String @id @default(cuid())

  sessionId String
  session   LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /**
   * invited — rung, not yet answered
   * joined  — got a token and connected
   * declined— said no, so the tutor stops waiting on them
   */
  status String @default("invited")

  joinedAt    DateTime?
  respondedAt DateTime?
  /**
   * How many times the tutor has rung. Shown to the tutor, not the student.
   */
  ringCount   Int       @default(1)

  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId, status])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Registration funnel.
//
// Enquiries land here, NOT in Student. A campaign can bring in thousands of
// registrants who never pay or enrol, and putting those straight into the
// roster would wreck every count the school reports on — class sizes, revenue
// per branch, attendance rates. An admin converts a Lead into a real Student
// (payment pending, access gated) when it is genuinely an enrolment.
// ---------------------------------------------------------------------------

model Lead {
  id    String  @id @default(cuid())
  name  String
  email String  @unique
  phone String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  /**
   * Level they enquired about, and the sitting they asked for.
   */
  interestedLevel String?
  sessionSlot     String?
  /**
   * group | private
   */
  classType       String  @default("group")

  /**
   * Where the enquiry came from: website, campaign name, csv_import, walk_in.
   */
  source String  @default("website")
  /**
   * new | invited | converted | dropped
   */
  status String  @default("new")
  notes  String?

  /**
   * When the enrolment invite was last emailed, so the office can chase.
   */
  invitedAt DateTime?

  /**
   * Set on conversion. One-to-one, so a Lead cannot be converted twice into
   * two competing student records.
   */
  convertedStudentId String?   @unique
  convertedStudent   Student?  @relation(fields: [convertedStudentId], references: [id], onDelete: SetNull)
  convertedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([branchId, interestedLevel])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Terms & Conditions and the refund requests they gate.
//
// See src/lib/terms.ts and src/lib/terms-content.ts for the document itself
// and the version/context vocabulary these two models are written against.
// ---------------------------------------------------------------------------

/// One instance of somebody agreeing to the school's Terms and Conditions.
///
/// Never updated after it is written — a re-acceptance under a new version, or
/// a second acknowledgement on the way into a refund request, is a NEW row, not
/// an edit of this one. That is what makes "which wording did this student
/// accept, and when" answerable months later: the history is the point, not
/// just the latest state.
model TermsAcceptance {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Denormalised so the admin screen can filter by branch/level without a
  /// second lookup, same reasoning as SupportTicket.studentId.
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  /// signup | refund | reprompt — see TERMS_CONTEXT in src/lib/terms.ts.
  context String

  /// TERMS_VERSION at the moment this was accepted, e.g. "2026-08-24". Not a
  /// foreign key to anything — the document's own text is generated from the
  /// school's docx and never stored row-by-row, so the version string IS the
  /// record of what they agreed to.
  version String

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([tenantId, context, createdAt])
  @@index([tenantId])
}

/// A student's request for their money back, and the school's decision on it.
///
/// Section 23 of the Terms is a NO by default with named exceptions (a
/// cancelled cohort, chiefly), not a blanket refusal — so this is a real
/// workflow with a real "approved" outcome, not a formality that always ends
/// in rejection. What makes it a legal record rather than an ordinary support
/// thread is `acceptedTermsVersion`/`acceptedTermsAt`: the exact wording the
/// student re-acknowledged, and when, captured at the moment they submitted —
/// denormalised onto the row itself (the AuditLog pattern) rather than left to
/// a join against TermsAcceptance, so the row still answers the question after
/// the version has moved on.
model RefundRequest {
  id String @id @default(cuid())

  userId String
  user   User   @relation("RefundRequestStudent", fields: [userId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  /// submitted | under_review | approved | rejected | paid
  status String @default("submitted")

  fullName         String
  phone            String
  courseOrPackage  String
  /// Paystack reference or receipt number, per the section 24 procedure.
  paymentReference String
  reason           String
  /// Uploaded file URLs (photos of a receipt, a withdrawal letter). Optional —
  /// section 24 asks for these "where applicable".
  supportingDocs   Json?

  acceptedTermsVersion String
  acceptedTermsAt      DateTime

  /// What the student says they paid, in naira — informational, not binding.
  requestedAmount Int?
  /// What Management actually approves. Section 23 caps this at 70% once
  /// administrative charges are deducted; nothing in code enforces that
  /// number, the same way nothing enforces a tuition price — it is a decision
  /// a person makes and this records it.
  decisionAmount  Int?
  decisionNote    String?

  decidedById String?
  decidedBy   User?     @relation("RefundRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  /// Section 25: processing may take up to 30 days after approval. Set when
  /// the money actually moves, not when it was approved.
  paidAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// See src/lib/prisma-guard.ts — a refund decision is exactly the kind of
  /// financial record the school must still be able to produce next year.
  deletedAt DateTime?

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// The help desk.
//
// SEPARATE FROM `Lead`, and the two live next to each other so the distinction
// stays obvious. A Lead is a stranger who wants to buy something; a ticket is a
// student who already has and cannot make it work. They land on the same admin
// screen because the same person answers both — but a ticket must never be
// counted in the enrolment funnel, and a lead must never appear as an
// unanswered support request.
//
// WHY A THREAD RATHER THAN A MESSAGE. The thing a student actually wants is not
// to file a complaint, it is to get an answer — which means the office replies,
// the student clarifies, and the office replies again. Storing one body on the
// ticket would have forced that conversation into email, where the school then
// cannot see it, and the whole reason this exists is that support conversations
// were happening on WhatsApp where nothing is recorded.
// ---------------------------------------------------------------------------

model SupportTicket {
  id String @id @default(cuid())

  /**
   * Keyed on User, not Student. Tutors hit problems too, and a desk that can
   * only hear from students would push staff back onto WhatsApp — which is the
   * exact thing this replaces.
   */
  userId String
  user   User   @relation("SupportTicketAuthor", fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Set when the asker is a student, so the office can open their file without
   * a second lookup and can filter the queue by branch and level.
   */
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  subject String
  /**
   * account | payment | classes | technical | other — how the queue is sorted.
   */
  topic   String @default("other")
  /**
   * open | pending | resolved
   */
  status  String @default("open")

  /**
   * WHERE THEY WERE STANDING WHEN THEY ASKED.
   * Captured automatically rather than typed. Half of all support messages are
   * some version of "this page is not working", and the single most useful fact
   * — which page — is the one a frustrated person is least likely to include.
   */
  fromPath String?

  /**
   * The admin who picked it up. Null while it is nobody's in particular.
   */
  assignedToId String?
  assignedTo   User?   @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /**
   * Two unread flags rather than one, because "unread" means different things
   * to the two sides and a single flag would make each side clear the other's.
   * These are what drive the ping on the sidebar at both ends.
   */
  unreadForAdmin Boolean @default(true)
  unreadForUser  Boolean @default(false)

  /**
   * Sort key for the queue. Denormalised so the list needs no join to order.
   */
  lastMessageAt DateTime  @default(now())
  resolvedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportTicketMessage[]

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, lastMessageAt])
  @@index([userId, createdAt])
  @@index([unreadForAdmin, status])
  @@index([tenantId])
}

/// Beta feedback is a product conversation, not a support ticket. It is
/// intentionally bounded and categorised so the office can spot themes
/// without turning free text into a surveillance stream.
model BetaFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String   @default("improve")
  message   String
  path      String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([userId, createdAt])
}

/// Coarse feature-level usage signals. No keystrokes, message bodies, URLs
/// with identifiers, or page content are stored. Rows are only written after
/// the user has explicitly enabled beta analytics.
/**
 * ONE THING A LEARNER DID.
 * This started life as a beta-programme counter: it recorded the first path
 * segment of a page somebody sat on for more than five seconds, and nothing
 * else. That is enough to say "the community tab is popular" and not enough to
 * say anything about a person.
 * The columns below are the difference between counting and understanding.
 * `hourLocal`/`weekday` are stamped BY THE BROWSER, from the learner's own
 * clock — a server timestamp tells you when a row was written, which is a fact
 * about our hosting region, not about whether this student studies at
 * midnight. `sessionKey` groups a burst of events into one visit, which is what
 * makes "how long is a sitting" and "how many sittings a week" answerable at
 * all. `path` keeps the whole route so /community/threads and /community can
 * be told apart, while `area` stays coarse so the aggregates stay readable.
 * Rows are small and numerous by design. The derived reading of them lives in
 * LearnerBehaviourProfile so that no admin screen ever scans this table live.
 */
model LearnerUsageEvent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /**
   * Coarse bucket, e.g. "community". Aggregates group on this.
   */
  area            String
  /**
   * view | click | complete | start | submit | play | search | idle
   */
  action          String   @default("view")
  /**
   * The full in-app route, e.g. "/community/threads/abc".
   */
  path            String?
  /**
   * Free label for the thing acted on — a button name, a lesson slug.
   */
  detail          String?
  /**
   * mobile | tablet | desktop, as the browser reported it.
   */
  deviceKind      String?
  /**
   * 0-23 on the LEARNER'S clock, not the server's. Null on old rows.
   */
  hourLocal       Int?
  /**
   * 0 = Sunday … 6 = Saturday, on the learner's clock.
   */
  weekday         Int?
  /**
   * Groups events belonging to one continuous visit.
   */
  sessionKey      String?
  durationSeconds Int      @default(0)
  occurredAt      DateTime @default(now())

  @@index([tenantId, area, occurredAt])
  @@index([userId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([sessionKey])
}

/**
 * WHAT WE HAVE WORKED OUT ABOUT ONE LEARNER, cached.
 * Every number here is derived — delete the whole table and a recompute
 * rebuilds it from LearnerUsageEvent and the academic records. It exists
 * because the admin screens ask questions ("who is drifting away", "who are
 * the night owls") that would otherwise mean scanning millions of event rows
 * on every page load.
 * `signals` carries the full computed blob (hour histogram, weekday
 * histogram, area mix, streaks) so the profile screen can draw charts without
 * a second pass; the scalar columns exist so the LIST screen can sort and
 * filter in the database.
 */
model LearnerBehaviourProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /**
   * Machine key of the behaviour archetype — see src/lib/learner-signals.ts.
   */
  archetype         String @default("newcomer")
  /**
   * Hour of day, on the learner's own clock, when they are most often here.
   */
  peakHour          Int?
  /**
   * 0 = Sunday … 6 = Saturday.
   */
  peakWeekday       Int?
  sessionsPerWeek   Float  @default(0)
  avgSessionMinutes Float  @default(0)
  /**
   * 0-1. How concentrated their timing is: 1 = clockwork, 0 = scattered.
   */
  predictability    Float  @default(0)
  /**
   * 0-100, blended from recency, frequency and depth.
   */
  engagementScore   Float  @default(0)
  /**
   * 0-100. High means the pattern looks like somebody about to disappear.
   */
  riskScore         Float  @default(0)
  /**
   * Days since their last recorded event; null if never seen.
   */
  daysSinceSeen     Int?
  totalEvents       Int    @default(0)
  activeDays        Int    @default(0)
  /**
   * Full computed blob: histograms, area mix, streaks, top surfaces.
   */
  signals           Json?

  computedAt DateTime @default(now())

  @@index([tenantId, riskScore])
  @@index([tenantId, archetype])
  @@index([tenantId, engagementScore])
}

model SupportTicketMessage {
  id String @id @default(cuid())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /**
   * Which side wrote it, snapshotted at the time. Read from the author's role
   * instead and a student who is later made an admin would retroactively turn
   * every question they ever asked into an official answer.
   */
  authorRole String

  body String

  createdAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([tenantId])
}

// A certificate is a historical document, so the level, branch, tutor and score
// are SNAPSHOT here rather than read through the student relation at render
// time. A student promoted from A1 to A2, or moved from Lagos to Abuja, must
// still hold an A1 Lagos certificate afterwards.
//
// Every student who completes a session gets one. Passing decides the KIND, not
// whether there is a certificate at all: `achievement` for a pass, `completion`
// for attendance without one. Nothing in the wording of either says "failed".
model Certificate {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /**
   * achievement | completion
   */
  kind  String
  level String

  /**
   * distinction | merit | pass | participation — printed on the face.
   */
  award String @default("participation")

  /**
   * Printed serial, e.g. EW/CERT/2026/A1/0007. Public, so it must be unique.
   */
  serial     String @unique
  /**
   * Short code for third-party verification at /verify/<code>. Separate from
   * the serial because the serial is guessable by design (it counts up) and a
   * guessable code would let anyone enumerate every student's result.
   */
  verifyCode String @unique

  /**
   * Average across all grades at issue. Null when the student was never scored.
   */
  averageScore Int?
  passed       Boolean @default(false)

  // Snapshots, deliberately denormalised. See the note above.
  studentName String
  studentCode String?
  branchName  String?
  tutorName   String?
  batch       String?

  /**
   * The course dates the certificate states: when this student started the
   * level and when they finished it.
   * Snapshots like everything else here. Derived from the batch month and the
   * session length at issue rather than read back later, because a student who
   * repeats a level or moves batch would otherwise change the dates printed on
   * a document already in somebody's hand.
   * Nullable for certificates issued before this existed; the document simply
   * omits the line rather than printing a guess.
   */
  courseStart DateTime?
  courseEnd   DateTime?

  /**
   * Tuition still owed when the certificate was issued, kept for the record.
   * The PROVISIONAL stamp is NOT driven by this column — it is recomputed from
   * the live balance, so a student who settles up later gets a clean document
   * instead of being punished forever by a snapshot.
   */
  outstandingAtIssue Int @default(0)

  issuedAt  DateTime  @default(now())
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /**
   * Set instead of the row being removed. See src/lib/prisma-guard.ts — the
   * client rewrites delete into an update on every model listed here, and
   * filters these rows out of ordinary reads, so the application behaves as
   * though the row is gone while the data is still on disk and restorable.
   */
  deletedAt DateTime?

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // One certificate per student per level. Re-running the issuer is safe.
  @@unique([studentId, level])
  @@index([issuedAt])
  @@index([tenantId])
}

/**
 * Something the assistant proposed, and what happened to it.
 * THE MODEL DOES NOT WRITE TO THE DATABASE. It writes a ROW HERE, describing
 * what it would do, and that row is inert until a named human presses Confirm.
 * Executing is a second, separate request that carries only this row's id — so
 * the thing that runs is the thing that was reviewed, not a re-derivation of it
 * from a conversation that has since moved on.
 * That split is the whole safety story. A model that misreads "not paid" as
 * "not fully paid" produces a plan that says, in the admin's own screen, "this
 * will message 214 students" — and 214 is visibly wrong where "I have messaged
 * the unpaid students" is not. The preview is the review surface, and the
 * frozen payload is what makes the preview binding.
 * It doubles as the audit log, which is not a coincidence: the record of what
 * was proposed, by whom, on whose account, and whether it ran, is the same
 * record either way. Rows are never deleted — a cancelled plan is evidence too.
 */
model AdminAction {
  id String @id @default(cuid())

  /**
   * Which action, e.g. message_students, mark_attendance, promote_students.
   * Matched back to the registry in src/lib/assistant-actions.ts at execute
   * time; an action that no longer exists refuses to run rather than guessing.
   */
  kind String

  /**
   * The capability the executing admin must hold. Stored rather than looked up
   * so a later change to the registry cannot silently widen an old plan.
   */
  capability String

  /**
   * One line, as shown on the confirm card.
   */
  summary String
  /**
   * The frozen arguments, exactly as validated when the plan was made. This is
   * what executes — never the model's later retelling.
   */
  payload Json
  /**
   * The preview the human actually approved: counts, sample rows, warnings.
   * Kept so the audit trail records what was on screen, not just what ran.
   */
  preview Json?

  /**
   * How many records this would touch, for the list view.
   */
  affectedCount Int @default(0)

  /**
   * pending | executed | cancelled | expired | failed
   */
  status String @default("pending")

  /**
   * The admin whose question produced it.
   */
  createdById String
  createdBy   User   @relation("AdminActionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  /**
   * The admin who pressed Confirm. Usually the same person, deliberately not
   * assumed to be: a plan left open on a shared front-desk machine and executed
   * by whoever sat down next is exactly the event this column exists to record.
   */
  executedById String?
  executedBy   User?   @relation("AdminActionExecutor", fields: [executedById], references: [id], onDelete: SetNull)

  /**
   * What running it actually did — delivered counts, ids touched, errors.
   */
  result Json?
  error  String?

  /**
   * Plans go stale. A fee-chase list assembled an hour ago may have had three
   * of its students pay since, so a plan past this is refused and must be
   * re-asked rather than executed against a world that has moved.
   */
  expiresAt  DateTime
  executedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdById, status])
  @@index([createdAt])
  @@index([tenantId])
}

/**
 * The append-only record of who changed what.
 * This table is the undo button. A backup restores the whole school to a
 * moment in time, which is the wrong instrument for the failure that actually
 * happens: one person removes one thing by mistake and nobody notices for
 * three days. Rolling back to Tuesday to recover one student would discard
 * every payment, mark and message from Wednesday and Thursday. So the before
 * image of each destructive write is kept here, and a single row can be put
 * back without touching anything else.
 * Nothing in the application updates or deletes a row in this table. The guard
 * in src/lib/prisma-guard.ts refuses both, so a compromised admin account can
 * cause damage but cannot erase the evidence of having caused it.
 */
model AuditLog {
  id String @id @default(cuid())

  /**
   * create | update | delete | deleteMany | updateMany | restore |
   * login | loginFailed | export | permissionChange | secretAccess
   */
  action String

  /**
   * The Prisma model, e.g. "Student". Null for events with no table.
   */
  model    String?
  /**
   * The row, when the event concerns exactly one.
   */
  recordId String?

  /**
   * The row exactly as it stood before the write, as JSON.
   * This is what makes restore possible, and it is also why this table is
   * treated as confidential: a before image of a Student carries the same
   * personal data the row itself did. The retention job in the recovery
   * runbook prunes it on the same clock as the rest of the student record.
   */
  before Json?
  /**
   * The row after the write, for updates. Null on deletes.
   */
  after  Json?

  /**
   * How many rows the statement touched. Above one this was a bulk write and
   * `before` holds an array rather than a single row.
   */
  affectedCount Int @default(1)

  /**
   * One line in plain German-school English, for the trail's list view.
   */
  summary String?

  /**
   * Who did it. SetNull rather than Cascade — deleting a staff account must
   * never take that person's history with it, which is the exact record you
   * want most when an account is being removed under suspicion.
   */
  actorId    String?
  actor      User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /**
   * The actor's email and role copied in at write time. Denormalised on
   * purpose: it survives the account being deleted, renamed, or demoted, and
   * an audit trail that reads "(deleted user)" is not a trail.
   */
  actorEmail String?
  actorRole  String?

  /**
   * Where it came from: app | script | cron | assistant | seed.
   */
  source String @default("app")

  /**
   * Request context. The IP is stored because a sign-in from an unexpected
   * country is the earliest visible sign of a stolen password, and there is
   * nowhere else in this system that would notice.
   */
  ip        String?
  userAgent String?
  route     String?
  requestId String?

  /**
   * info | notice | alert — alert is what the admin dashboard surfaces.
   */
  severity String @default("info")

  /**
   * False once put back, so the trail cannot be replayed twice.
   */
  restorable   Boolean   @default(false)
  restoredAt   DateTime?
  restoredById String?
  restoredBy   User?     @relation("AuditRestorer", fields: [restoredById], references: [id], onDelete: SetNull)

  at DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([at])
  @@index([model, recordId])
  @@index([actorId, at])
  @@index([action, at])
  @@index([severity, at])
  @@index([restorable, at])
  @@index([tenantId])
}

/**
 * One row per backup attempt, written by the GitHub Actions jobs.
 * The point is not the record, it is the absence of one. A backup that has
 * quietly failed for six weeks looks exactly like a backup that is working,
 * right up until the morning it is needed. The daily cron checks this table
 * and raises an admin alert when the newest success is older than 26 hours,
 * so silence becomes noisy.
 */
model BackupRun {
  id String @id @default(cuid())

  /**
   * database | objects | drill
   */
  kind   String
  /**
   * running | success | failed
   */
  status String @default("running")

  /**
   * The restic snapshot id, so the runbook can name what to restore.
   */
  snapshotId String?
  sizeBytes  BigInt?
  /**
   * Row counts per model on a drill, transfer stats on a mirror.
   */
  detail     Json?
  error      String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([kind, status, startedAt])
  @@index([startedAt])
  @@index([tenantId])
}

/// A single-use, short-lived permission to set a new password.
///
/// A NEW TABLE rather than columns on User, deliberately. Adding a column to a
/// populated table means the generated client selects something the live
/// database does not have yet, which is an error on every read until the push
/// lands. A new table only breaks queries against itself, so this can ship
/// ahead of its migration and simply not work until pushed.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// sha256 of the token, never the token.
  ///
  /// Same reasoning as the password column beside it: this table is a list of
  /// live "become this person" credentials, so a database dump must not be a
  /// list of working reset links. The raw value exists only in the email.
  tokenHash String @unique

  /// One hour. Long enough for someone to find the mail, short enough that a
  /// forwarded or archived message stops being a key by the afternoon.
  expiresAt DateTime

  /// Set the moment it is spent. Presence here means the token is dead, and
  /// the most recent one also tells the session layer when this account's
  /// password last changed.
  usedAt DateTime?

  /// Kept for abuse investigation — whose connection asked for this.
  requestedIp String?

  createdAt DateTime @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
}

// ===========================================================================
// Metered billing, in the shape AI providers use: an append-only event ledger,
// a daily rollup you actually bill from, and a prepaid balance.
// ===========================================================================

/// One billable thing that happened. Append-only — never updated, never
/// deleted. Corrections are written as a second event with a negative
/// quantity, so the ledger stays a history rather than a current opinion.
model UsageEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// See METERS in src/lib/usage/meter.ts. A string rather than an enum so a
  /// new meter does not need a migration — pricing changes far more often
  /// than schemas should.
  meter String

  /// Whole units of the meter's smallest unit (tokens, minutes, bytes, 1).
  /// Integer, because money computed from floats is money that disagrees with
  /// itself at the fourth decimal place and cannot be reconciled.
  quantity Int

  /// THE FIELD THAT PREVENTS DOUBLE BILLING.
  ///
  /// Webhooks retry. Jobs re-run. A LiveKit session can report twice. Without
  /// a unique key the second delivery bills the customer again, which is the
  /// one class of bug that ends a platform's reputation in a single incident.
  /// Callers derive it from the source event, never from a timestamp or a
  /// random value.
  idempotencyKey String @unique

  /// When it happened, not when it was recorded — a job draining a queue must
  /// not push usage into the wrong billing day.
  occurredAt DateTime @default(now())

  /// Free-form context for the invoice line: which student, which session,
  /// which model. Never read for arithmetic.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([tenantId, meter, occurredAt])
  @@index([tenantId, occurredAt])
}

/// The rollup invoices are computed from.
///
/// Billing scans the raw ledger exactly never: at a million events a month
/// that is a table scan per invoice per tenant. A nightly job folds events
/// into this, and this is what the finance page and the invoice read.
model UsageDaily {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  meter    String
  /// Midnight UTC of the day being summarised.
  day      DateTime
  quantity Int
  /// Cost in kobo at the rate that applied on the day. Stored rather than
  /// recomputed so that changing a price tomorrow cannot silently restate
  /// last month's invoice.
  costKobo Int

  @@unique([tenantId, meter, day])
  @@index([tenantId, day])
}

/// Prepaid balance, in kobo.
///
/// Prepaid rather than card-on-file: it matches how AI providers actually
/// work, it removes failed-charge collection entirely, and in a market where
/// card declines are ordinary it means a failed payment is a top-up that did
/// not happen rather than a service interruption plus a debt.
model TenantCredit {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// BigInt, not Int. Int tops out at about ₦21m in kobo, which is a plausible
  /// annual spend for one large customer and therefore a ceiling that would be
  /// hit by success rather than by error.
  balanceKobo BigInt @default(0)

  /// Below this, the low-balance warning fires. Above zero on purpose —
  /// warning a customer after they have already been cut off is not a warning.
  lowBalanceKobo BigInt @default(500000)

  /// How far past zero this tenant may go before metered work is refused. A
  /// school mid-term should not lose its register over a late top-up.
  graceKobo BigInt @default(0)

  /// Whether the low-balance warning has already been sent for the current dip.
  /// Cleared on top-up, so one warning arrives per dip rather than one per hour.
  lowBalanceNotifiedAt DateTime?

  updatedAt DateTime @updatedAt

  @@index([balanceKobo])
}

/// Every movement of the balance, in both directions.
///
/// The balance field is a cached total; this is the thing it must always agree
/// with. Without it, "why is my balance ₦40,000 when I topped up ₦50,000" has
/// no answer, and a billing question with no answer is a refund.
model CreditTransaction {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// topup | usage | adjustment | refund
  kind String

  /// Positive adds, negative removes. Signed rather than a separate direction
  /// column so that summing the column is the balance, with nothing to get
  /// backwards.
  amountKobo BigInt

  /// The balance immediately after this movement, so a statement can be read
  /// without replaying every row before it.
  balanceAfterKobo BigInt

  /// Paystack's reference on a top-up; the rollup day on a usage debit.
  reference String?

  /// Same rule as UsageEvent: derived from the source event so a retried
  /// webhook cannot credit the same payment twice.
  idempotencyKey String @unique

  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ===========================================================================
// Outbound webhooks — how a partner's own system hears about a payment or an
// enrolment without polling us for it.
// ===========================================================================

model WebhookEndpoint {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  url String

  /// Signs every delivery. Shown once, at creation, like an API key — a
  /// signature the receiver cannot verify is decoration.
  secret String

  /// Comma-separated event names, or "*". Empty means the endpoint is
  /// configured but subscribed to nothing, which is different from deleted.
  events String @default("*")

  disabledAt   DateTime?
  /// Consecutive failures. Past a threshold the endpoint is disabled, because
  /// retrying forever into a dead URL is how a queue becomes the outage.
  failureCount Int       @default(0)

  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([tenantId, disabledAt])
}

model WebhookDelivery {
  id         String          @id @default(cuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  /// Carried directly rather than reached through the endpoint. Every
  /// tenant-owned table in this schema has the column, without exception —
  /// "this one is safe because of how it is joined" is the sentence that
  /// precedes the leak, and a row-level security policy cannot follow a join.
  tenantId  String
  tenantRef Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  event   String
  payload Json

  /// pending | delivered | failed
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastStatus    Int?
  lastError     String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

// ---------------------------------------------------------------------------
// The live quiz game — the classroom's Kahoot.
//
// WHY THE SERVER IS THE HOST, AND NOT THE TUTOR'S BROWSER
//
// The obvious build is a state machine on the LiveKit data channel: the room
// already carries chat, hand-raise and reactions, so the game could ride the
// same wire for nothing. It is the wrong shape here, for three reasons that
// each on their own would decide it.
//
//  1. THE ROOM IS OFTEN NOT A ROOM. The tutors who asked for this teach teens
//     in a branch classroom. There is no SFU session — the tutor projects onto
//     a wall and thirty phones are on the school wifi. A data-channel game
//     works only for the online cohorts, which are the minority.
//  2. SPEED SCORING IS A CLOCK, AND A CLOCK IS AN ATTACK SURFACE. Points fall
//     with the milliseconds, so whoever holds the stopwatch decides the winner.
//     A browser holding it can be edited by the person it is scoring.
//  3. A PHONE THAT LOCKS MUST NOT LOSE THE GAME. Ephemeral state dies with the
//     tab. A row does not — a student can lock their phone, walk to the board,
//     come back and still be in third place.
//
// So the phases live in a column, the clock is `questionEndsAt` compared
// against the database's own idea of now, and every client — the big screen
// included — is a reader of the same row. See src/lib/live-quiz.ts.
// ---------------------------------------------------------------------------

model QuizGame {
  id String @id @default(cuid())

  /**
   * Six digits, not the six letters a live class uses.
   * Deliberately a different alphabet from LiveClassSession.joinCode. A quiz
   * PIN is typed by a fourteen-year-old on a phone in a hurry, and digits open
   * the numeric keypad; letters open a full keyboard and cost three taps and a
   * typo. The visible difference is a feature too — "the game PIN is the one
   * with numbers" is a sentence a tutor can say once and never repeat.
   */
  pin String @unique

  /**
   * The quiz this came from, kept for the report — but NOT read during play.
   * See `questions` below.
   */
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  /**
   * A FROZEN COPY of the questions, taken when the game is created.
   * Not a convenience. A tutor fixing a typo in the source quiz halfway through
   * a game would otherwise change what a question was worth after half the
   * class had already answered it, and re-marking a finished game months later
   * would grade it against a paper nobody sat. Paragraph questions are dropped
   * at snapshot time: nothing can hand-mark an essay against a twenty-second
   * countdown.
   */
  questions Json

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)
  hostUserId String

  /**
   * Who it is for, so a student's portal can offer the game without the PIN.
   */
  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  level       String?
  sessionSlot String?

  /**
   * The video lesson this was played inside, when there was one.
   */
  liveSessionId String?
  liveSession   LiveClassSession? @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)

  title String

  /**
   * lobby | question | reveal | standings | ended
   * `reveal` and `standings` are separate phases on purpose. Showing the right
   * answer and showing the table are two different moments in a room: the first
   * is quiet and everyone reads it, the second is loud. Collapsing them means
   * nobody looks at the answer.
   */
  phase String @default("lobby")

  /**
   * -1 while in the lobby.
   */
  currentIndex Int @default(-1)

  /**
   * The clock, server-side. `questionStartedAt` is the zero point every
   * response time is measured from, and `questionEndsAt` is the only thing that
   * decides whether an answer was in time.
   */
  questionStartedAt DateTime?
  questionEndsAt    DateTime?

  /**
   * How long each question runs. Per game, because a drill and a reading comprehension are not the same.
   */
  secondsPerQuestion Int @default(20)

  /**
   * Whether answering fast is worth more. Off makes it a plain quiz, which is
   * the right setting for a slower group who would otherwise never place —
   * speed scoring quietly punishes the students who are still translating.
   */
  speedBonus Boolean @default(true)

  /// When enabled, the host advances after the reveal/standings pause.
  autoAdvance Boolean @default(false)

  /**
   * Shuffle the order so a class that played yesterday cannot chant the answers.
   */
  shuffled Boolean @default(false)

  /**
   * Play in teams rather than as individuals.
   * The reason this is worth having in a LANGUAGE school specifically: a solo
   * leaderboard is won by whoever already speaks the most German, so the
   * students who most need to practise learn within two rounds that they cannot
   * place and stop trying. In a team the weakest speaker's correct answer still
   * moves their team, and the room starts helping each other out loud — which
   * is the actual lesson.
   * Individual scores are still recorded underneath, because the gradebook and
   * the XP count are about a person, not a table of four.
   */
  teamMode Boolean @default(false)

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  players QuizGamePlayer[]
  answers QuizGameAnswer[]

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([pin])
  @@index([branchId, level, sessionSlot, endedAt])
  @@index([lecturerId, createdAt])
  @@index([tenantId])
}

/**
 * One student in one game.
 * There is no nickname column and that is a decision. Kahoot's joke names are
 * most of its charm and exactly what makes it unusable as a school record: a
 * leaderboard of pseudonyms tells a tutor nothing about who is struggling, and
 * in a room of teenagers the free-text box is a moderation problem waiting for
 * a parent to see the projector. Players are their own names, from their own
 * accounts, which is also the only way a score can ever mean anything later.
 */
model QuizGamePlayer {
  id     String   @id @default(cuid())
  gameId String
  game   QuizGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  score      Int @default(0)
  /**
   * Consecutive correct answers, for the streak bonus. Reset by a wrong one.
   */
  streak     Int @default(0)
  bestStreak Int @default(0)
  correct    Int @default(0)
  answered   Int @default(0)

  /**
   * Which team, when the game is played in teams. Null in a solo game.
   * A name rather than a foreign key to a Team table: a team exists for forty
   * minutes and has no life outside this one game, so a row for it would be a
   * row nothing ever reads again. The set of names is fixed in code
   * (`QUIZ_TEAMS` in src/lib/live-quiz.ts) and validated on join, so this can
   * never hold a name the projector has no colour for.
   */
  team String?

  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  answers QuizGameAnswer[]

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([gameId, studentId])
  @@index([gameId, score])
  @@index([gameId, team])
  @@index([tenantId])
}

/**
 * One student's self-mark on one quest generated from a tutor's material
 * (see src/lib/material-ai.ts). One row per (student, material, questIndex) —
 * self-marking again just flips `correct` on the same row rather than piling
 * up attempts, matching how the rest of the app treats self-reported
 * completion. XP is never written here: src/api/student/gamification counts
 * `correct: true` rows the same way it counts finished missions or quiz games.
 */
model MaterialQuestAttempt {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  questIndex Int
  correct    Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId, questIndex])
  @@index([tenantId])
  @@index([studentId])
}

/**
 * One answer to one question. The unique constraint is the anti-cheat: a second
 * POST for a question already answered is refused by the database rather than
 * by a check that could race thirty ways at once.
 */
model QuizGameAnswer {
  id     String   @id @default(cuid())
  gameId String
  game   QuizGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  playerId String
  player   QuizGamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  questionIndex Int

  /**
   * Shape depends on the question type, exactly as AssignmentSubmission.answers.
   */
  answer Json?

  correct Boolean @default(false)
  /**
   * 0..1 — a multi-select can be part right.
   */
  credit  Float   @default(0)
  points  Int     @default(0)

  /**
   * Measured from QuizGame.questionStartedAt on the server. Never sent by the client.
   */
  msTaken    Int
  answeredAt DateTime @default(now())

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([playerId, questionIndex])
  @@index([gameId, questionIndex])
  @@index([tenantId])
}

/**
 * One story written by a cohort, turn by turn.
 * A match belongs to a Space (branch + level + session), so it scopes to the
 * cohort naturally. Private students get cross-branch pool matching handled
 * separately; this model stays the same.
 * The story itself is built from GameTurn submissions in order — the channel
 * renders it, the GameMatch row just keeps state.
 */
model GameMatch {
  id          String  @id @default(cuid())
  spaceId     String?
  space       Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  title       String
  prompt      String?
  /**
   * Tutor or system auto-start. Null for school-wide defaults.
   */
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  /**
   * active | completed | archived. Completed = all turns done, no more moves.
   */
  status String @default("active")

  /**
   * How many sentences before the story is finished.
   * A story that could run forever never gets read back, and the moment it is
   * finished — the class scrolls the whole thing and sees what they made — is
   * the payoff the turns were for. Without an end there is no such moment, only
   * an endlessly growing thread that quietly stops.
   */
  targetTurns Int @default(12)

  /**
   * The deck this story draws its per-turn rules from, as a JSON array.
   * COPIED off the ConstraintDeck at creation rather than referenced, for the
   * same reason the quiz game freezes its questions: a tutor editing a deck
   * mid-story must not retroactively change what turn three was asked to do.
   * Null means the story runs without rules, which is the right setting for a
   * beginner cohort who need the writing to be the whole difficulty.
   */
  constraints Json?

  /**
   * The turns in order.
   */
  turns GameTurn[]

  /**
   * The chat message(s) that invited people into this match — see Message.gameMatchId.
   */
  messages Message[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([spaceId, status, createdAt])
  @@index([tenantId])
}

/**
 * One turn in a story — one sentence.
 * THE ASSIGNED/CLAIMED SPLIT IS THE WHOLE DESIGN, and it is what keeps a chain
 * alive. A turn is *offered* to one named student, because "it is your turn"
 * aimed at a person is the entire retention mechanic — a turn owed to nobody is
 * a turn nobody feels. But a turn that can ONLY be played by that student stalls
 * the story the first time somebody is ill, drops the course, or simply does not
 * open the app, and a chain that dies at student three teaches nobody anything.
 * So the deadline does not skip the turn. It OPENS it: past `deadline` the turn
 * stays in place and anyone in the cohort may take it. The named student keeps
 * their claim until they lose it to somebody faster, which is both fairer than a
 * silent skip and quietly motivating.
 * `playerId` is therefore who actually wrote the sentence, which is usually but
 * not always `assignedToId`. Scoring, streaks and the tutor's review all read
 * `playerId`; only the notification reads `assignedToId`.
 */
model GameTurn {
  id      String    @id @default(cuid())
  matchId String
  match   GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  /**
   * Who the turn was offered to. Set at creation, never changes.
   */
  assignedToId String
  assignedTo   User   @relation("GameTurnAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)

  /**
   * Who actually wrote it. Null until somebody does.
   */
  playerId String?
  player   User?   @relation("GameTurnAuthor", fields: [playerId], references: [id], onDelete: SetNull)

  /**
   * 1, 2, 3... the order in the game.
   */
  position Int

  /**
   * pending  — waiting on the assignee, before the deadline
   * open     — deadline passed, anyone in the cohort may take it
   * submitted — written
   * Stored rather than derived from `deadline` because "open" is a thing the
   * cohort gets *notified* about, and a state nobody can observe cannot be
   * announced.
   */
  status String @default("pending")

  /**
   * JSON: {rule: "dative"} | {rule: "vocab", words: ["Bauer", "Schloss"]} etc.
   */
  constraint Json?

  /**
   * The sentence written for this turn. Null until submitted.
   */
  sentence String?

  submittedAt DateTime?
  /**
   * When this turn stops being exclusive to the assignee. ~24h out.
   */
  deadline    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([matchId, position])
  /// "What am I being waited on for" — the query behind the Games tab badge.
  @@index([assignedToId, status])
  @@index([playerId])
  /// Finding turns whose deadline has passed, for the opener job.
  @@index([status, deadline])
  @@index([tenantId])
}

/**
 * Reusable constraint decks — sets of rules a tutor can pick from when
 * starting a game, or the school defaults to. Constraints are JSON so new
 * types can be added without schema migration.
 * Examples:
 * {rule: "dative"}
 * {rule: "vocab", words: ["Bauer", "Schloss", "Ausbildung"]}
 * {rule: "grammar", pattern: "weil", label: "must contain weil"}
 * {rule: "tense", tense: "future"}
 */
model ConstraintDeck {
  id          String  @id @default(cuid())
  name        String
  description String?
  /**
   * JSON array of constraint objects.
   */
  constraints Json
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// ===========================================================================
/// WORK DRIVE  —  Phase 0 (files pillar).  See docs/WORK_DRIVE.md
/// ===========================================================================
/// A staff-only file store + calendar + webinars area of the admin portal. The
/// organising unit is a Workspace: a team hub that holds files, a calendar and
/// (later) a live room. `Space` was already taken by community chat, hence the
/// name.
///
/// Every table here carries `tenantId` directly — child tables included — so
/// the Prisma guard's per-model tenant scoping (src/lib/prisma-guard.ts)
/// covers them with no join, the same way ChannelRead and MessageReaction do.
///
/// "Who did this" columns (createdById, uploadedById, actorId, assigneeId) are
/// plain user-id strings with NO relation, matching Material.uploadedBy and
/// ClassRecording.startedByUserId: the person can be soft-deleted while the
/// file they uploaded lives on, and the audit trail — not a foreign key — is
/// the record of who did what.

model Workspace {
  id          String  @id @default(cuid())
  name        String
  /// URL-safe, unique per tenant. The workspace's address under /admin/work-drive.
  slug        String
  description String?
  /// A name from the shared icon set (components/icons.tsx), never an emoji.
  icon        String  @default("folder")
  /// A theme token key ("sky" | "amber" | ...), resolved through the theme so
  /// it stays legible in Tag/Nacht/Daemmerung. Never a raw hex.
  color       String  @default("slate")
  /// general | department | project | event — grouping plus which empty state
  /// and defaults to show. An `event` workspace is built around one WorkEvent
  /// and archived with it.
  kind        String  @default("general")
  /// private | staff | branch
  ///   private  only WorkspaceMembers
  ///   staff    every admin/lecturer in the tenant (read-only unless a member)
  ///   branch   staff at `branchId`
  /// Fail closed: an unknown value is read as `private`.
  visibility  String  @default("private")
  /// Set only when visibility = branch.
  branchId    String?
  createdById String?
  /// Soft archive: hidden from the default list, files intact. Distinct from
  /// deletedAt, which is the trash.
  archivedAt  DateTime?
  /// Denormalised sum of live DriveFile.sizeBytes here, kept in step on
  /// upload/delete so the quota meter needs no aggregate.
  storageUsedBytes BigInt @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members  WorkspaceMember[]
  folders  DriveFolder[]
  files    DriveFile[]
  activity FileActivity[]

  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, visibility])
}

/// Who is in a private workspace and at what level. Absent for staff/branch
/// workspaces unless someone is pinned in with a higher role than the default.
model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Plain user id, no relation — the same convention as the actor columns
  /// above. A membership row for a since-deleted account is harmless and is
  /// swept by the workspace-member cleanup, not a database cascade.
  userId      String
  /// owner | editor | viewer
  role        String    @default("viewer")
  addedById   String?
  createdAt   DateTime  @default(now())

  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([tenantId])
}

/// A folder in a workspace's tree.
model DriveFolder {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      DriveFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    DriveFolder[] @relation("FolderTree")
  name        String
  /// Materialised path from the workspace root, e.g. "/Finance/2026/Q3". Kept
  /// in step on move/rename so breadcrumbs and prefix search need no recursion.
  path        String   @default("/")
  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  files DriveFile[]

  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, parentId, name])
  @@index([workspaceId])
  @@index([workspaceId, parentId])
  @@index([tenantId])
}

/// One file. The bytes live in the object bucket at `storageKey`; this row is
/// the metadata everything else reads.
model DriveFile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      DriveFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name        String
  mimeType    String   @default("application/octet-stream")
  sizeBytes   BigInt   @default(0)
  /// R2 object key under the `work-drive/` prefix. See src/lib/storage.ts.
  storageKey  String
  /// sha256 of the current bytes — integrity checks and duplicate detection.
  checksum    String?
  /// document | spreadsheet | image | video | audio | pdf | archive | other —
  /// derived from mimeType on upload, drives the icon and the type filter.
  kind        String   @default("other")
  /// FK to the current DriveFileVersion. Null until the first version row is
  /// written (which happens on upload). @unique so a version is "current" for
  /// exactly one file.
  currentVersionId String? @unique
  currentVersion   DriveFileVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  createdById      String?
  lastModifiedById String?

  /// A capped slice of the file's extracted text, denormalised here so search
  /// hits one table. Null = not extracted yet, or a format with no text (an
  /// image, a video). The fuller copy is in DriveFileText. Filled by a
  /// background job after upload — see src/lib/work-drive/index-file.ts.
  textContent String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  versions DriveFileVersion[] @relation("FileVersions")
  text     DriveFileText?
  comments FileComment[]

  /// Full-text search vector over the FILENAME only — a Postgres generated
  /// column (see 20260903140000_work_drive_files). Content search is a second
  /// GIN index over `to_tsvector(textContent)` added in the Phase 2 migration;
  /// the search route ORs the two. Unsupported so Prisma leaves it alone.
  searchVector Unsupported("tsvector")?

  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, folderId])
  @@index([tenantId])
  @@index([checksum])
}

/// An immutable prior state of a file. The newest is also pointed at by
/// DriveFile.currentVersionId. Never soft-deleted; a retention job prunes old
/// ones (Phase 5).
model DriveFileVersion {
  id            String    @id @default(cuid())
  fileId        String
  file          DriveFile @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 … monotonic per file.
  versionNumber Int
  storageKey    String
  sizeBytes     BigInt    @default(0)
  checksum      String?
  uploadedById  String?
  /// Optional "what changed" note from whoever uploaded it.
  note          String?
  createdAt     DateTime  @default(now())

  currentOf DriveFile? @relation("CurrentVersion")

  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([fileId, versionNumber])
  @@index([fileId])
  @@index([tenantId])
}

/// Extracted plain text for search, kept off the hot DriveFile row because it
/// can be large and is read only by the indexer. Populated by a background job
/// in Phase 2.
model DriveFileText {
  id          String    @id @default(cuid())
  fileId      String    @unique
  file        DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  content     String
  extractedAt DateTime  @default(now())

  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Grants one staff user access to one file or folder they are not otherwise a
/// member of. No public link tokens in v1 — sharing is always to a named
/// person inside the tenant.
model FileShare {
  id         String @id @default(cuid())
  /// file | folder
  targetType String
  targetId   String
  sharedById String?
  /// The recipient's user id. Plain string, no relation — matches the actor
  /// columns. A revoke or the account's deletion is what ends a share; an
  /// orphaned row is filtered out at read time by the recipient lookup.
  sharedWithUserId String
  /// view | edit
  permission String   @default("view")
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, sharedWithUserId])
  @@index([sharedWithUserId, revokedAt])
  @@index([tenantId])
}

/// The in-UI activity feed for a workspace. Deliberately separate from the
/// security AuditLog: this is "what happened in here lately" for the people
/// working in the workspace, not the tamper-evident record.
model FileActivity {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fileId      String?
  folderId    String?
  actorId     String?
  /// uploaded | renamed | moved | new_version | deleted | restored | shared |
  /// downloaded | commented
  action      String
  /// Shape depends on the action: { from, to } for renamed/moved, { name } etc.
  meta        Json?
  createdAt   DateTime  @default(now())

  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([fileId])
  @@index([tenantId])
}

/// A comment thread on a file.
model FileComment {
  id        String    @id @default(cuid())
  fileId    String
  file      DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([fileId, createdAt])
  @@index([tenantId])
}
