  completed       Boolean @default(false)

  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

