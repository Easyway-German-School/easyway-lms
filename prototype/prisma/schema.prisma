  content     String // HTML/markdown
  type        String @default("lesson") // "lesson", "quiz", "assignment", "discussion"
  order       Int
  duration    Int // minutes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions Completion[]

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Material {
  id       String  @id @default(cuid())
  /**
   * Optional since class recordings arrived. A recording belongs to a level
   * and a date, not to a course — forcing tutors to pick an unrelated course
   * just to upload Tuesday's class would have put junk in the catalogue.
   */
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  title       String
  description String?
  filePath    String // relative path to file
  fileName    String
  fileType    String // pdf, doc, video, image, etc
  fileSize    Int // bytes
  uploadedBy  String? // admin user id who uploaded

  /**
   * document | video | recording.
   * `fileType` already says "video/mp4", but it cannot tell a taught lesson
   * apart from an auto-captured class recording, and the library shelves the
   * two differently. Derived from fileType on upload, so old rows read as
   * documents until backfilled.
   */
  kind String @default("document")

  /**
   * Video shelf metadata. All nullable: a PDF has none of it, and a video
   * uploaded before the library existed simply shows fewer details rather
   * than breaking the row.
   */
  durationSeconds Int?
  thumbnailPath   String?

  /**
   * What the AI made of this material, built in the background after upload.
   * Denormalised onto the row rather than left in AiCache alone because the
   * student's materials list reads it on every render, and a join through a
   * hash key for something shown this often is work for nothing. AiCache
   * remains the record of the generation; this is the copy that gets read.
   * Null means "not generated yet" and the UI simply shows the material as it
   * always did — a tutor uploading at 6am for a 9am class must not have their
   * material hidden because a queue has not run.
   */
  aiSummary     String?
  /**
   * Bullet points a student can skim in fifteen seconds.
   */
  aiKeyPoints   Json?
  /**
   * Quests generated from this material: short, concrete tasks with an answer,
   * so reading it turns into something to do rather than something to file.
   */
  aiQuests      Json?
  /**
   * A written-up study note built from this material in the same background
   * pass as `aiSummary`/`aiQuests` — see src/lib/material-ai.ts. Shape:
   * `{ overview, sections: [{heading, points[]}], vocabulary: [{de,en,note?}],
   * grammar?: [] }`. This is what lands in a student's "My Notes" hub so the
   * tutor's handout arrives already read for them. Gated on the SAME tutor
   * sign-off as the quests (`questsReviewedAt`) — the model's output never
   * reaches a student unmoderated.
   */
  aiNotes       Json?
  aiState       String    @default("none") // none | pending | ready | failed
  aiUpdatedAt   DateTime?
  /**
   * A tutor's sign-off on the AI-generated quests, separate from `aiState`
   * (which only tracks whether generation finished, not whether anyone
   * checked the result). Null means "generated but unreviewed" — a student
   * never sees quests for this material until a tutor has looked at them.
   */
  questsReviewedAt DateTime?
  questsReviewedBy String?
  /**
   * Which CEFR level this belongs to. Duplicated from `course.level` on
   * purpose — a class recording belongs to a level but not always to a
   * course, and the library filters on level far more often than it joins.
   */
  level         String?
  /**
   * Groups episodes into a shelf, e.g. "A1 Speaking Lab". Free text: the
   * tutor names their own series, the library rows come from whatever exists.
   */
  series        String?
  episodeNumber Int?
  /**
   * Recorded-on date for a class tape, which is what the library sorts and
   * labels by. Distinct from createdAt, since a tutor often uploads last
   * week's class today.
   */
  recordedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSessions      ClassSession[]
  privateClasses     PrivateClass[]
  privateClassSeries PrivateClassSeries[]
  videoProgress      VideoProgress[]
  studentClassNotes  StudentClassNote[]
  recording          ClassRecording?
  questAttempts      MaterialQuestAttempt[]
  /**
   * Set instead of the row being removed. See src/lib/prisma-guard.ts — the
   * client rewrites delete into an update on every model listed here, and
   * filters these rows out of ordinary reads, so the application behaves as
   * though the row is gone while the data is still on disk and restorable.
   */
  deletedAt          DateTime?

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([kind, level])
  // Exists in the database but had fallen out of this file, so any `db push`
  // would silently drop it. The AI backfill sweeps for aiState = "pending",
  // which is the one query that scans this column.
  @@index([aiState])
  @@index([tenantId])
}

/**
 * One captured live class.
 * This row exists because the file does not arrive when the class ends — the
 * egress service finishes encoding and uploading a few minutes later, and tells
 * us over a webhook. Something has to remember which room that job belonged to
 * in the meantime, and has to be there for the reconciler to find if the
 * webhook never arrives (it cannot reach a laptop, for one).
 * It is also the audit trail for a class that failed to record, which is worth
 * more than it sounds: "was Tuesday recorded?" should be answerable without
 * reading logs.
 */
model ClassRecording {
  id String @id @default(cuid())

  /**
   * LiveKit's id for the capture job. The join key for webhooks.
   */
  egressId String @unique
  roomName String

  /**
   * Denormalised so a recording is filable even if the cohort later changes.
   */
  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  level       String?
  sessionSlot String?

  /**
   * Which tutor's join started it, for the audit trail.
   */
  startedByUserId String?

  /**
   * Set only for a private one-to-one capture — see class-recorder.ts and
   * live/session/route.ts for why this used to be excluded outright. A
   * private recording's Material is deliberately never given `level`, so it
   * cannot appear on the level-wide "class recordings" shelf everyone else
   * sees: visibility is scoped through this relation instead (one occurrence,
   * one enrolled student), the same relation `/admin` already reads to file
   * a private lesson under its student.
   */
  privateClassId String?
  privateClass   PrivateClass? @relation(fields: [privateClassId], references: [id], onDelete: SetNull)

  /**
   * active | completed | failed | aborted | purged
   * `aborted` is a capture we stopped deliberately (an empty room), which is
   * not a failure and should not be alarmed on. `purged` means retention
   * reclaimed the file — the row survives so "was Tuesday recorded?" stays
   * answerable after the video itself is gone.
   */
  status String @default("active")

  /**
   * video | audio — which capture profile was used. An audio recording is
   * roughly a seventh the size and is the right default for a language class,
   * where the payload is speech.
   */
  variant String @default("video")

  /**
   * Set by a tutor or admin on a class worth keeping: a landmark lesson, an
   * exam briefing. Retention never touches these, whatever the policy says.
   */
  keepForever Boolean @default(false)

  /**
   * When retention reclaimed the file. Null while the video still exists.
   */
  purgedAt DateTime?

  /**
   * When this recording stops being visible to STUDENTS — set to 14 days
   * after the class on publish (see src/lib/class-recorder.ts). This is a
   * read-side filter only: nothing is deleted. The assigned tutor and admin
   * keep every recording forever regardless. The AI class notes
   * (`ClassTranscript`) and anything the student wrote survive past this and
   * stay in their "My Notes" hub — only the video itself goes. `keepForever`
   * overrides it, keeping the video on the student's shelf too.
   */
  studentExpiresAt DateTime?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  /**
   * Where it landed in the bucket, and what the player should request.
   */
  objectKey String?
  fileUrl   String?

  durationSeconds Int?
  sizeBytes       Int?
  error           String?

  /**
   * The library row, created once the file is safely uploaded.
   */
  materialId String?   @unique
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  /**
   * Set instead of the row being removed. See src/lib/prisma-guard.ts — the
   * client rewrites delete into an update on every model listed here, and
   * filters these rows out of ordinary reads, so the application behaves as
   * though the row is gone while the data is still on disk and restorable.
   */
  deletedAt  DateTime?

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  transcript ClassTranscript?

  @@index([status, startedAt])
  @@index([roomName, status])
  @@index([privateClassId])
  @@index([studentExpiresAt])
  @@index([tenantId])
}

/**
 * The Happy-Scribe-style layer on top of a class recording: a transcript,
 * turned into a summary, action items and the German vocabulary actually
 * taught that session.
 * One row per `ClassRecording`, built once in the background after the file
 * is verified readable (see `class-transcription.ts`), never on a request a
 * student is waiting on — the ASR call alone can take longer than a page load
 * should. Kept separate from `ClassRecording` rather than bolted onto it:
 * that row's job is "did the capture succeed", this row's job is "what did
 * the class actually cover", and they fail independently — a transcription
 * provider being down must never mark a perfectly good recording as broken.
 * Private one-to-one classes never reach this model at all: `ClassRecording`
 * rows are only ever created for group classes (see class-recorder.ts's own
 * module comment on why private capture is a consent decision, not a gap),
 * so nothing here needs its own private/group check.
 */
model ClassTranscript {
  id String @id @default(cuid())

  classRecordingId String         @unique
  classRecording   ClassRecording @relation(fields: [classRecordingId], references: [id], onDelete: Cascade)

  /**
   * pending | transcribing | summarizing | ready | failed | skipped_too_large | none
   * `none` is a recording with nothing to transcribe (silent, or the audio
   * track never made it) — not a failure, same distinction Material.aiState
   * already draws for a video with no readable text.
   */
  status String @default("pending")

  /**
   * Flattened ASR output, capped at prompt size for the summarizer — see
   * MAX_TRANSCRIPT_PROMPT_CHARS in class-transcription.ts. Kept in full here
   * (not just the capped version) since the PDF export and a future
   * "jump to this moment" reader both want the whole thing.
   */
  transcriptText String?
  /**
   * [{start, end, text}] straight from Whisper's verbose_json — no speaker
   * diarization (that needs a model this stack does not run; see the module
   * comment in class-transcription.ts). Timestamps only, in seconds.
   */
  segments       Json?

  summary     String?
  /**
   * 3-6 short bullets — what a student skimming for 15 seconds needs.
   */
  keyPoints   Json?
  /**
   * Concrete follow-ups named in class: "practice the dative", "bring your workbook Thursday".
   */
  actionItems Json?
  /**
   * [{de, en, note?}] — new words/phrases this specific class actually taught.
   */
  vocabulary  Json?

  /**
   * Set when `classRecording.privateClassId` is set. Gates a richer prompt
   * (see buildPrivateNotesPrompt in class-transcription.ts) a group class's
   * transcript cannot honestly support — with fifteen voices in the room
   * there is no reliable "this correction was FOR this student"; with
   * exactly two, there is.
   */
  isPrivate Boolean @default(false)
  /**
   * Private only. [{mistake, correction, note?}] — corrected in this
   * session, named from the transcript, never invented.
   */
  corrections Json?
  /**
   * Private only. Short list of concrete moments the tutor praised or the
   * student visibly improved on.
   */
  progressHighlights Json?

  /**
   * [{from, to, speaker}] — `from`/`to` are indices into `segments` below,
   * `speaker` is "tutor" | "student". A COARSE guess, not diarization: it
   * distinguishes the tutor's voice from everyone else's by phrasing
   * (explaining vs. asking/answering), never claims to know WHICH student
   * spoke in a group class. Ranges rather than one label per segment,
   * because most turns run several segments long and this keeps the
   * summarizer's output small regardless of how long the class ran.
   */
  speakerRanges Json?

  /**
   * Which ASR/LLM pair produced this, so a bad batch is findable and clearable.
   */
  provider String?
  error    String?

  /**
   * Set the first time a student asks to share this class's notes — see
   * `/api/student/videos/:id/notes/share`. Null until then: generating it
   * eagerly for every transcript would mean a working public URL exists for
   * a class nobody ever asked to share. Never offered for a private lesson
   * (`isPrivate`) — the public page this resolves to never reads
   * `corrections`/`progressHighlights` regardless, but the share route
   * itself refuses to issue a token at all, since even the shared summary
   * and vocabulary belong to one paying family's one-to-one lesson.
   */
  shareToken String? @unique

  generatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tenantId])
}

/**
 * A student's own editable copy of a class's notes — "just like Zoho
 * Notebook": whatever they type is theirs, autosaved, and never touched by a
 * later re-generation of the AI notes above. That last part matters:
 * `ClassTranscript` can be regenerated (a retried failure, a better model
 * later) without ever clobbering something a student wrote in their own copy.
 *
 * One per (student, material) rather than per transcript, so a student can
 * start jotting notes while watching even before the AI pass finishes — the
 * two are independent, exactly like `VideoProgress` tracks a position
 * regardless of whether AI summarisation ever runs on a material at all.
 */
model StudentClassNote {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  content String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
  @@index([tenantId])
}

