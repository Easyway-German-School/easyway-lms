// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(STUDENT)
  /**
   * Which kind of admin, when role is ADMIN: super | secretary | data_comm.
   * Null for everyone else. Deliberately a separate field rather than more
   * Role values, so every existing auth check on ADMIN keeps working and
   * existing admins keep full access by defaulting to super.
   */
  adminRole String?
  /**
   * False on an account created by an exam booking, which starts with a
   * password nobody knows. The claim link works only while this is false, so
   * a forwarded confirmation email cannot be used to take the account later.
   */
  passwordClaimed Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student         Student?
  lecturer        Lecturer?
  sessions        Session[]
  missionProgress MissionProgress[]
  threads         Thread[]
  comments        Comment[]
  channelReads    ChannelRead[]
  pushSubs        PushSubscription[]
  examRegistrations ExamRegistration[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  tutorId String?
  tutor   Lecturer? @relation(fields: [tutorId], references: [id], onDelete: SetNull)

  // Official school identifier, e.g. EW/2026/A1/JUL/0007. Nullable because
  // students created before the scheme existed are backfilled by
  // scripts/backfill-student-codes.mjs rather than blocked at read time.
  studentCode String? @unique

  status        String @default("active")
  level         String @default("A1") // A1, A2, B1, B2, C1, C2
  /** morning | afternoon | evening — which sitting of their level they attend. */
  sessionSlot   String @default("morning")
  /**
   * group | private. A private student sits no group timetable, so the
   * generated branch+level schedule does not apply to them — their calendar
   * comes from PrivateClass rows instead.
   */
  classType     String @default("group")
  pathway       String @default("Goethe exam mastery")
  examReadiness Int    @default(0)
  outcome       String @default("Goethe C1 readiness + German work placement support")
  nextLive      String @default("No live session scheduled")
  // Arbitrary admission form payload saved as JSON
  admission     Json?
  
  // Graduation tracking
  graduationDate DateTime?
  
  // Email tracking for scheduled reminders
  feeRemindersScheduled Json? // tracks which reminders (7d, 14d, 30d) have been sent
  emailPreferences Json? // user preferences for notification types

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments       Enrollment[]
  progress          Progress[]
  grades            Grade[]
  completions       Completion[]
  personalizedPlan  PersonalizedPlan?
  examRegistrations ExamRegistration[]
  attendances       Attendance[]
  notifications     Notification[]
  invoices          Invoice[]
  payments          Payment[]
  assignmentSubmissions AssignmentSubmission[]
  privateClasses    PrivateClass[]
  convertedFromLead Lead?
}

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  location  String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students      Student[]
  notifications Notification[]
  spaces        Space[]
  classSessions ClassSession[]
  assignments   Assignment[]
  exams         Exam[]
  lecturers     Lecturer[]
  leads         Lead[]
}

model ExamRegistration {
  id String @id @default(cuid())

  /**
   * Null for an external candidate. The centre sits members of the public for
   * ÖSD, not only enrolled students, and requiring a Student row made that
   * impossible.
   */
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /**
   * The account that owns this booking — set for students AND candidates, so
   * "my exams" is a single query rather than two paths that can disagree.
   */
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /** Details captured for candidates who are not students. */
  candidateName  String?
  candidateEmail String?
  candidatePhone String?

  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: SetNull)

  examName String
  examDate DateTime
  /** registered | confirmed | cancelled | completed | no_show */
  status   String   @default("registered")
  notes    String?

  /** unpaid | paid | waived — a seat is only held once the fee is settled. */
  paymentStatus    String  @default("unpaid")
  paymentReference String?
  amountPaid       Int?

  seatNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId, status])
}

model Pathway {
  id          String @id @default(cuid())
  name        String @unique // "Goethe exam mastery", "Nursing career path", etc
  headline    String
  description String
  duration    String // "12 weeks", "6 months"
  level       String // "B1-C1", "A1-B2"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses     Course[]
  enrollments Enrollment[]
}

model Course {
  id        String  @id @default(cuid())
  pathwayId String
  pathway   Pathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  title       String
  description String
  order       Int // sequence in pathway
  duration    Int // minutes
  level       String // "A1", "B1", "C1"
  published   Boolean @default(true)

  // Integration mirroring: where this record came from and its id in that system.
  // source = "local" for records created in EasyWay; "moodle"/"canvas"/etc for mirrored ones.
  source     String  @default("local")
  externalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules      Module[]
  progress     Progress[]
  materials    Material[]
  classes      Class[]
  exams        Exam[]

  @@unique([source, externalId])
}

model Module {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String
  order       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]
}

model Lesson {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title       String
  description String
  content     String // HTML/markdown
  type        String @default("lesson") // "lesson", "quiz", "assignment", "discussion"
  order       Int
  duration    Int // minutes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions Completion[]
}

model Material {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  title       String
  description String?
  filePath    String // relative path to file
  fileName    String
  fileType    String // pdf, doc, video, image, etc
  fileSize    Int // bytes
  uploadedBy  String? // admin user id who uploaded
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSessions  ClassSession[]
  privateClasses PrivateClass[]
}

model Completion {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  status   String  @default("started") // "started", "in_progress", "completed"
  score    Int?
  feedback String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([studentId, lessonId])
}

model Progress {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  percentComplete Int       @default(0)
  started         DateTime  @default(now())
  completed       DateTime?

  @@unique([studentId, courseId])
}

model Enrollment {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  pathwayId String
  pathway   Pathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  classId String?
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  status          String  @default("active") // "active", "completed", "paused"
  stripeSessionId String? // for payment tracking

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([studentId, pathwayId])
}

model Grade {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  examId    String?
  exam      Exam?   @relation(fields: [examId], references: [id], onDelete: SetNull)

  type     String // "essay", "quiz", "speaking", "pronunciation", "exam"
  content  String? // the essay text, quiz answers, etc
  score    Int // 0-100
  grade    String? // A, B, C, D, F
  feedback String? // grading feedback

  /**
   * platform | physical — whether the work was sat on the LMS or on paper in
   * the branch. A physical score is keyed in by a tutor, so it has no
   * submission record behind it and cannot be audited the same way.
   */
  submissionMode String @default("platform")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, examId])
}

model MissionProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, missionId])
}

model PersonalizedPlan {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan      String // JSON stringified plan
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId])
}
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  channel   String   @default("email")
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  level     String?
  status    String   @default("pending")
  sentAt    DateTime?
  readAt    DateTime? // for in-app notifications
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      String    @default("draft")
  dueDate     DateTime?
  totalAmount Int
  currency    String    @default("usd")
  lineItems   Json?
  payments    Payment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payment {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount          Int
  currency        String   @default("usd")
  status          String   @default("pending")
  method          String
  description     String?
  stripeSessionId String?
  paymentIntentId String?
  welcomeEmailSentAt DateTime? // tracks when welcome email was sent
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EmailLog {
  id            String   @id @default(cuid())
  studentId     String?
  recipientEmail String
  type          String   // "welcome", "fee_reminder_7d", "fee_reminder_14d", "fee_reminder_30d", "exam_reminder", "graduation"
  subject       String
  status        String   @default("sent") // "sent", "failed", "bounced"
  sentAt        DateTime @default(now())
  errorMessage  String?
  retries       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([studentId])
  @@index([type])
  @@index([sentAt])
}
model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  
  date      DateTime
  present   Boolean  @default(true)
  status    String   @default("present") // present, absent, late, excused
  notes     String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
}



// Persisted state for each external LMS/community connector.
// Replaces the old in-memory scheduler so sync status survives restarts and
// is shared across every server instance (single source of truth for "always-on").
model IntegrationConnector {
  id              String    @id // "moodle", "canvas", "discourse", "open-edx"
  name            String
  enabled         Boolean   @default(true)
  autoSync        Boolean   @default(true)
  intervalMinutes Int       @default(30)

  status          String    @default("idle") // idle, syncing, connected, degraded, error
  lastSyncAt      DateTime?
  nextSyncAt      DateTime?
  lastError       String?
  itemsSynced     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lecturer {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  specialization String?
  bio            String?
  phone          String?

  /** Which class a tutor takes: branch + level + session. */
  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  level       String?
  sessionSlot String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  classes       Class[]
  exams         Exam[]
  materials     Material[]
  students      Student[]
  classSessions ClassSession[]
  assignments   Assignment[]
  privateClasses PrivateClass[]
}

model Class {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  lecturerId  String
  lecturer    Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  schedule    String? // JSON formatted schedule
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  enrollments Enrollment[]
  attendance  Attendance[]
}

model Exam {
  id       String  @id @default(cuid())
  // Optional: an ÖSD sitting the centre hosts belongs to no course and has no
  // assigned lecturer, while an internal course test has both.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  name        String
  description String?
  examDate    DateTime
  totalScore  Int      @default(100)

  /** ÖSD | Goethe | telc | internal — who awards the certificate. */
  examBody String @default("internal")
  /** CEFR level the sitting is for. */
  level    String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  /** Fee in kobo-free naira. Null means no fee (internal tests). */
  fee Int?

  /** Seats available. Null means uncapped. */
  capacity              Int?
  registrationDeadline  DateTime?

  /** Only published sittings are bookable by candidates. */
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades        Grade[]
  registrations ExamRegistration[]

  @@index([published, examDate])
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
  /** Registered for an exam only — no classes, materials or community. */
  CANDIDATE
}

// ---------------------------------------------------------------------------
// Community hub (Discord-style channels + Reddit-style threads).
// A Space is scoped to one branch AND one level, so "Lagos · A1" and
// "Abuja · A1" are separate communities even though the syllabus matches.
// ---------------------------------------------------------------------------

model Space {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  level       String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channels    Channel[]

  @@unique([branchId, level])
}

model Channel {
  id          String   @id @default(cuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  kind        String   @default("topic")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  threads     Thread[]
  reads       ChannelRead[]

  @@unique([spaceId, slug])
}

/**
 * Per-member read marker. Unread = threads in the channel whose lastActivityAt
 * is newer than lastReadAt. One row per (user, channel); absence means the
 * member has never opened the channel, so everything in it counts as unread.
 */
model ChannelRead {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@unique([userId, channelId])
  @@index([userId])
}

/**
 * A browser push endpoint (Web Push / VAPID). A member may have several — one
 * per device or browser — so the key is the endpoint, not the user.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Thread {
  id             String   @id @default(cuid())
  channelId      String
  channel        Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String
  body           String
  pinned         Boolean  @default(false)
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comments       Comment[]

  @@index([channelId, lastActivityAt])
}

model Comment {
  id        String    @id @default(cuid())
  threadId  String
  thread    Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Comment[] @relation("CommentChildren")
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([threadId, createdAt])
}

// ---------------------------------------------------------------------------
// Timetable overlay.
//
// src/lib/schedule.ts generates the SKELETON of a term from the batch/level
// rotation — which days a cohort meets. That skeleton is deterministic and has
// no database behind it. This model is the human layer on top: the real topic
// a tutor is teaching that day, the actual clock times, whether the class got
// postponed, and which material to bring.
//
// A row is created only when someone edits a day, so an untouched timetable
// costs nothing and the generator stays the source of truth for WHICH days a
// cohort meets.
// ---------------------------------------------------------------------------

model ClassSession {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  level    String

  /** Midnight UTC on the day of the class — the join key back to the skeleton. */
  date     DateTime
  /** morning | afternoon | evening — the branch runs all three. */
  timeSlot String @default("morning")

  startTime String? // "09:00"
  endTime   String? // "11:00"

  /** The day's topic, editable by the tutor and visible to students. */
  topic String?
  notes String?

  /** scheduled | postponed | cancelled | held */
  status      String    @default("scheduled")
  postponedTo DateTime?

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, level, date, timeSlot])
  @@index([branchId, level, date])
}

// ---------------------------------------------------------------------------
// Assignments: documents to hand in, and timed quizzes.
//
// Quiz questions and answers live in JSON rather than their own tables. The
// shape is small, always read as a whole, and never queried across rows — a
// question has no meaning outside its quiz — so tables would buy nothing.
// ---------------------------------------------------------------------------

model Assignment {
  id       String  @id @default(cuid())
  level    String
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  title       String
  description String?

  /** document | quiz */
  type String @default("document")

  /** Quizzes only. Null means untimed. */
  timeLimitMinutes Int?

  /** Quizzes only: [{ prompt, options: string[], answerIndex }] */
  questions Json?

  dueAt     DateTime?
  published Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions AssignmentSubmission[]

  @@index([level, branchId])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /** Documents: the written answer and/or an uploaded file. */
  text     String?
  filePath String?
  fileName String?

  /** Quizzes: the chosen option index per question. */
  answers Json?

  score    Int?
  feedback String?

  /** platform | physical — paper submissions are recorded by a tutor. */
  submissionMode String @default("platform")

  /**
   * Set when a timed quiz is opened. The deadline is derived from this on the
   * server, so a student cannot win time by reloading or editing the clock.
   */
  startedAt   DateTime?
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
}

// ---------------------------------------------------------------------------
// Outbound email pipeline.
//
// Mail is queued rather than sent inline: a bulk send to every unpaid student
// cannot block a request, and a provider hiccup must not lose the message.
// A worker drains the queue with backoff, and Suppression records addresses
// that must never be written to again.
// ---------------------------------------------------------------------------

model EmailMessage {
  id String @id @default(cuid())

  to      String
  subject String
  html    String
  /** welcome | fee_reminder | exam_reminder | bulk | ... */
  type    String @default("general")

  studentId String?

  /** queued | sending | sent | failed | suppressed | cancelled */
  status   String @default("queued")
  attempts Int    @default(0)
  lastError String?

  /** Not sent before this time; drives reminders and scheduled campaigns. */
  scheduledFor DateTime @default(now())
  sentAt       DateTime?

  /** Groups the messages produced by one bulk send. */
  campaignId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([campaignId])
}

model EmailSuppression {
  id     String @id @default(cuid())
  email  String @unique
  /** bounced | complained | unsubscribed | manual */
  reason String
  note   String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Private (one-to-one) classes.
//
// A private student has no branch+level timetable to generate from, so their
// calendar is these rows and nothing else. Kept separate from ClassSession
// because that model is keyed on branch + level + slot — the exact thing a
// private class does not have.
// ---------------------------------------------------------------------------

model PrivateClass {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  scheduledAt     DateTime
  durationMinutes Int     @default(60)
  topic           String?
  /** scheduled | completed | cancelled | postponed */
  status          String  @default("scheduled")
  notes           String?

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, scheduledAt])
}

// ---------------------------------------------------------------------------
// Registration funnel.
//
// Enquiries land here, NOT in Student. A campaign can bring in thousands of
// registrants who never pay or enrol, and putting those straight into the
// roster would wreck every count the school reports on — class sizes, revenue
// per branch, attendance rates. An admin converts a Lead into a real Student
// (payment pending, access gated) when it is genuinely an enrolment.
// ---------------------------------------------------------------------------

model Lead {
  id    String  @id @default(cuid())
  name  String
  email String  @unique
  phone String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  /** Level they enquired about, and the sitting they asked for. */
  interestedLevel String?
  sessionSlot     String?
  /** group | private */
  classType       String  @default("group")

  /** Where the enquiry came from: website, campaign name, csv_import, walk_in. */
  source String @default("website")
  /** new | contacted | converted | dropped */
  status String @default("new")
  notes  String?

  /**
   * Set on conversion. One-to-one, so a Lead cannot be converted twice into
   * two competing student records.
   */
  convertedStudentId String?  @unique
  convertedStudent   Student? @relation(fields: [convertedStudentId], references: [id], onDelete: SetNull)
  convertedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([branchId, interestedLevel])
}
