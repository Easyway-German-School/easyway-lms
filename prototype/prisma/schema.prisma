/**
 * One notification, for anybody.
 * It began as a student-only record and the student columns are kept exactly
 * as they were, so every row already written still resolves. What is new is
 * `userId` and `audience`, which is what lets the same table reach a lecturer
 * or an admin:
 * userId set        one person, whoever they are
 * studentId set     one student (the original shape)
 * branchId / level  every student matching, the existing broadcast
 * audience set      everyone holding that role — "admin", "lecturer",
 * "student", or "all"
 * A row with none of them is a notice to the whole school. Delivery goes
 * through src/lib/notify.ts; nothing should write this table directly.
 */
model Notification {
  id      String @id @default(cuid())
  title   String
  message String
  /**
   * email | in-app. Only in-app rows reach the bell.
   */
  channel String @default("email")

  /**
   * Addressed to exactly this account, whatever role it holds.
   */
  userId String?
  user   User?   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  level     String?

  /**
   * Broadcast to a whole role: student | lecturer | admin | all.
   */
  audience String?

  /**
   * What happened, in one machine-readable token — "payment.received",
   * "student.registered", "gateway.error". Drives the icon, and lets the
   * portal filter without pattern-matching the title, which is what the bell
   * used to do.
   */
  kind String @default("general")

  /**
   * info | success | warning | critical. Critical is what makes noise.
   */
  severity String @default("info")

  /**
   * Where clicking it should take the reader.
   */
  link String?

  /**
   * Who sent it, when a person did. Null for anything the system raised.
   */
  senderId String?
  sender   User?   @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  /**
   * One id shared by every row a single send produced.
   * Notifications are fanned out — a broadcast to 200 students writes 200
   * rows, because one row shared between readers cannot record which of them
   * has read it. This is what lets the admin list fold that send back into a
   * single line.
   */
  batchId String?

  /**
   * Caller-supplied idempotency token. A second send with the same key to the
   * same person is dropped, which is how the payment-warning tiers and the
   * level-advance offer avoid firing twice.
   */
  dedupeKey String?

  status    String    @default("pending")
  sentAt    DateTime?
  readAt    DateTime? // for in-app notifications
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Tenant that owns this row. See src/lib/tenant/registry.ts.
  tenantId  String?
  tenantRef Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([audience, readAt])
  @@index([studentId, readAt])
  @@index([batchId])
  @@index([dedupeKey])
  @@index([createdAt])
  @@index([tenantId])
}

