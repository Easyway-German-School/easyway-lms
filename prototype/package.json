{
  "name": "prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:port": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/port-sqlite-to-postgres.ts",
    "check:actions": "tsx --tsconfig tsconfig.json scripts/check-assistant-actions.ts",
    "bench:brain": "tsx --tsconfig tsconfig.json scripts/bench-local-brain.ts",
    "check:livekit": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/check-livekit.ts",
    "check:live": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/check-live-presence.ts",
    "check:latency": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/check-latency.ts",
    "test:retention": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/test-retention.ts",
    "check:guard": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/check-guard.ts",
    "backup": "node scripts/snapshot-db.mjs",
    "backup:verify": "node scripts/verify-snapshot.mjs",
    "prove": "node scripts/prove-tenant-isolation.mjs && node scripts/prove-api-key.mjs && node scripts/prove-v1-api.mjs && tsx scripts/prove-billing.ts && tsx scripts/prove-admin-scope.ts && tsx scripts/prove-tenant-features.ts && tsx scripts/prove-credit-block.ts",
    "seed:spaces": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/seed-community-spaces.ts",
    "verify:community": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/verify-community.ts",
    "test:community": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/test-community-e2e.ts",
    "backfill:thumbnails": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/backfill-recording-thumbnails.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@babel/runtime": "^8.0.0",
    "@livekit/egress-sdk": "^0.2.1",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.101.4",
    "@tldraw/tldraw": "^5.1.1",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.42.2",
    "heic2any": "^0.0.4",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "mammoth": "^1.12.0",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "otplib": "^13.4.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-webcam": "^7.2.0",
    "sharp": "^0.35.3",
    "stripe": "^22.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/next-auth": "^3.13.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^7",
    "vitest": "^3.2.7"
  }
}
