{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --include=dev --no-audit --no-fund",
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/tick-fast",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "src/app/api/ai/**/route.ts": { "maxDuration": 60 },
    "src/app/api/student/private-schedule-preferences/suggest/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/intelligence/route.ts": { "maxDuration": 60 },
    "src/app/api/live/recording/**/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/students/import/route.ts": { "maxDuration": 60 },
    "src/app/api/cron/tick/route.ts": { "maxDuration": 300 },
    "src/app/api/cron/tick-fast/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/class-notes-health/route.ts": { "maxDuration": 300 }
  }
}
